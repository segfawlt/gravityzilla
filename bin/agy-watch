        "pull",
    }
)
MUTATING_PKG_SUBS = frozenset({"install", "add", "remove", "uninstall", "update", "fmt", "fix"})

VALID_CID_RE = re.compile(r"^[A-Za-z0-9_-]{4,128}$")
RTK_PREFIX_RE = re.compile(r"^\s*(?:\S*/)?rtk\s+(?:bypass\s+)?")
QUOTED_STR_RE = re.compile(r"'[^']*'|\"(?:\\.|[^\"])*\"")
FILE_REDIRECT_RE = re.compile(r"(?<![-=<&\d])>>?\s*(?!/dev/null\b)(?![&\s]*\d)[A-Za-z0-9_./~\"'$]")
CMD_EXIT_CODE_RE = re.compile(r"Command exited with code\s+(-?\d+)")
STDIN_PROMPT_RE = re.compile(
    r"(?i)(\[y/n\]|\(y/n\)|\(yes/no\)|password\s*:|passphrase\s*:|enter pin|are you sure\?|press enter to continue)"
)
BG_TASK_ID_RE = re.compile(r"Tool is running as a background task with task id:\s*([^\s\n]+)")
TASK_DESC_RE = re.compile(r"Task Description:\s*(.+)")
INLINE_ENV_ASSIGN_RE = re.compile(r"(?<![A-Za-z0-9_.-])([A-Za-z_][A-Za-z0-9_]*)=(\S+)")
SUBAGENT_CID_RE = re.compile(r'"conversationId"\s*:\s*"([A-Za-z0-9_-]{4,128})"')
USER_REQ_CLEAN_RE = re.compile(r"(?is)<ADDITIONAL_METADATA>.*?</ADDITIONAL_METADATA>|</?USER_REQUEST>")

UUID_RE = re.compile(r"\b[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\b")
ISO_TS_RE = re.compile(r"(?i)\b\d{4}-\d{2}-\d{2}[t ]\d{2}:\d{2}:\d{2}(?:\.\d+)?(?:z|[+-]\d{2}:?\d{2})?\b")
HEX_RE = re.compile(r"\b0x[0-9a-fA-F]+\b")
NUM_RE = re.compile(r"\b\d+\b")
WS_RE = re.compile(r"\s+")

DEFAULT_STATE: dict[str, Any] = {
    "enabled": True,
    "git_guard": True,
    "auto_kill_late_hangs": True,
    "model_warn_s": 90,
    "tool_warn_s": 60,
    "stdin_prompt_s": 4,
    "stop_idle_bounce_s": 12,
    "bg_hang_s": 90,
    "loops_blocked": 0,
    "git_guards_blocked": 0,
    "thrash_pivots": 0,
    "hangs_bounced": 0,
    "late_hangs_killed": 0,
}


def utc_iso_now() -> str:
    return dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def ensure_dirs() -> None:
    WATCHDOG_HOME.mkdir(parents=True, exist_ok=True)
    SESSIONS_DIR.mkdir(parents=True, exist_ok=True)


def sanitize_cid(cid: str) -> str:
    raw = str(cid or "").strip()
    if VALID_CID_RE.match(raw):
        return raw
    return ""


def atomic_write_json(path: Path, data: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    tmp.write_text(json.dumps(data, indent=2, sort_keys=False) + "\n", encoding="utf-8")
    os.replace(tmp, path)


@contextlib.contextmanager
def file_lock(lock_path: Path) -> Iterator[None]:
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    with lock_path.open("a+", encoding="utf-8") as fh:
        fcntl.flock(fh.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(fh.fileno(), fcntl.LOCK_UN)


def load_state() -> dict[str, Any]:
    ensure_dirs()
    if not STATE_FILE.is_file():
        return dict(DEFAULT_STATE)
    try:
        raw = json.loads(STATE_FILE.read_text(encoding="utf-8"))
        if isinstance(raw, dict):
            merged = dict(DEFAULT_STATE)
            merged.update(raw)
            return merged
    except Exception:
        pass
    return dict(DEFAULT_STATE)


def save_state(state: dict[str, Any]) -> None:
    with file_lock(STATE_LOCK):
        atomic_write_json(STATE_FILE, state)


def update_state_field(mutator: Any) -> dict[str, Any]:
    with file_lock(STATE_LOCK):
        st = load_state()
        mutator(st)
        atomic_write_json(STATE_FILE, st)
        return st


def session_path(cid: str) -> Path:
    return SESSIONS_DIR / f"{cid}.json"


def session_lock_path(cid: str) -> Path:
    return SESSIONS_DIR / f"{cid}.lock"


def default_session(cid: str) -> dict[str, Any]:
    return {
        "cid": cid,
        "agy_pid": None,
        "cwd": "",
        "project": "",
        "model": "",
        "parent_cid": "",
        "role": "",
        "phase": "idle",
        "last_user_input": "",
        "model_started_mono_ns": 0,
        "model_started_epoch": 0.0,
        "turn_started_epoch": 0.0,
        "turn_step_count": 0,
        "total_steps": 0,
        "turn_tool_count": 0,
        "warned_step_45": False,
        "margin_step2_nudged": False,
        "mutation_seq": 0,
        "recent_calls": [],
        "file_hashes": {},
        "err_cursor_step_idx": -1,
        "consecutive_same_err": {"sig": "", "count": 0, "sample": "", "warned_at": 0},
        "inflight_tools": {},
        "last_step": None,
        "pending_guidance": [],
        "stop_bounced_tasks": [],
        "last_alert": None,
        "updated_at": 0.0,
    }


def _sync_session_meta(sess: dict[str, Any], payload: dict[str, Any]) -> str:
    """Populate session cwd/project/model from hook payload without clobbering existing metadata."""
    cwd = extract_cwd(payload)
    if cwd:
        sess["cwd"] = cwd
        sess["project"] = Path(cwd).name or cwd
    model = str(payload.get("modelName") or "").strip()
    if model:
        sess["model"] = model
    return cwd or str(sess.get("cwd") or "")


def load_session(cid: str) -> dict[str, Any]:
    p = session_path(cid)
    base = default_session(cid)
    if not p.is_file():
        return base
    try:
        raw = json.loads(p.read_text(encoding="utf-8"))
        if isinstance(raw, dict):
            base.update(raw)
            base["cid"] = cid
    except Exception:
        pass
    return base


def save_session(cid: str, sess: dict[str, Any]) -> None:
    sess["updated_at"] = time.time()
    atomic_write_json(session_path(cid), sess)


def _clear_sync_stall_alert(sess: dict[str, Any]) -> None:
    alert = sess.get("last_alert")
    if (
        isinstance(alert, dict)
        and alert.get("kind") == "stall"
        and not str(alert.get("detail") or "").startswith("task-")
    ):
        sess["last_alert"] = None


def _rotate_if_oversized(path: Path, max_bytes: int) -> None:
    try:
        if path.is_file() and path.stat().st_size > max_bytes:
            backup = path.with_name(path.name + ".1")
            os.replace(path, backup)
    except Exception:
        pass


def append_event(
    cid: str,
    event: str,
    step_idx: int | None = None,
    tool_id: str = "",
    tool: str = "",
    duration_ms: int | None = None,
    status: str = "",
    detail: str = "",
    project: str = "",
    target: str = "",
) -> None:
    ensure_dirs()
    record: dict[str, Any] = {
        "ts": utc_iso_now(),
        "mono_ns": time.monotonic_ns(),
        "cid": cid,
        "event": event,
    }
    if project:
        record["project"] = project
    if step_idx is not None:
        record["step_idx"] = step_idx
    if tool_id:
        record["tool_id"] = tool_id
    if tool:
        record["tool"] = tool
    if target:
        record["target"] = target
    if duration_ms is not None:
        record["duration_ms"] = duration_ms
    if status:
        record["status"] = status
    if detail:
        record["detail"] = detail
    line = json.dumps(record, ensure_ascii=True, separators=(",", ":")) + "\n"
    try:
        with file_lock(EVENTS_LOCK):
            _rotate_if_oversized(EVENTS_FILE, MAX_EVENTS_BYTES)
            with EVENTS_FILE.open("a", encoding="utf-8") as fh:
                fh.write(line)
    except Exception:
        pass


def log_line(msg: str) -> None:
    ensure_dirs()
    stamp = dt.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    line = f"[{stamp}] {msg}\n"
    try:
        with file_lock(EVENTS_LOCK):
            _rotate_if_oversized(LOG_FILE, MAX_LOG_BYTES)
            with LOG_FILE.open("a", encoding="utf-8") as fh:
                fh.write(line)
    except Exception:
        pass


# ---------------------------------------------------------------------------
# Linux /proc/<pid>/stat & /proc/<pid>/comm inspection (never environ/cmdline)
# ---------------------------------------------------------------------------


def _read_proc_stat(pid: int) -> tuple[str, int, int, int] | None:
    """Return (comm, ppid, pgrp, utime + stime) from /proc/<pid>/stat only."""
    try:
        raw = Path(f"/proc/{pid}/stat").read_text(encoding="utf-8", errors="replace")
    except Exception:
        return None
    lpar = raw.find("(")
    rpar = raw.rfind(")")
    if lpar < 0 or rpar <= lpar:
        return None
    comm = raw[lpar + 1 : rpar]
    after = raw[rpar + 2 :].split()
    if len(after) < 13:
        return None
    try:
        ppid = int(after[1])
        pgrp = int(after[2])
        utime = int(after[11])
        stime = int(after[12])
    except ValueError:
        return None
    try:
        full_comm = Path(f"/proc/{pid}/comm").read_text(encoding="utf-8", errors="replace").strip()
        if full_comm:
            comm = full_comm
    except Exception:
        pass
    return comm, ppid, pgrp, utime + stime


def find_ancestor_agy_pid() -> int | None:
    """Walk up to 6 parent hops using /proc/<pid>/stat and /proc/<pid>/comm only."""
    pid = os.getppid()
    seen: set[int] = set()
    for _ in range(6):
        if pid <= 1 or pid in seen:
            break
        seen.add(pid)
        info = _read_proc_stat(pid)
        if info is None:
            break
        comm, ppid, _pgrp, _ticks = info
        if comm == "agy":
            return pid
        pid = ppid
    return None


def _build_proc_tree() -> tuple[dict[int, list[tuple[int, int, str, int]]], dict[int, tuple[int, int, str, int]]]:
    """Scan numeric /proc/<pid>/stat files only (no environ/cmdline)."""
    children_map: dict[int, list[tuple[int, int, str, int]]] = {}
    stats_map: dict[int, tuple[int, int, str, int]] = {}
    try:
        entries = os.listdir("/proc")
    except Exception:
        return children_map, stats_map
    for name in entries:
        if not name.isdigit():
            continue
        pid = int(name)
        info = _read_proc_stat(pid)
        if info is None:
            continue
        comm, ppid, pgrp, ticks = info
        stats_map[pid] = (ppid, pgrp, comm, ticks)
        children_map.setdefault(ppid, []).append((pid, pgrp, comm, ticks))
    return children_map, stats_map


def sample_agy_child_shells(agy_pid: int | None) -> tuple[int, list[tuple[int, int, str]]]:
    """Return (total_cpu_ticks, [(child_pid, child_pgrp, comm), ...]) for agy shell children."""
    if not agy_pid or agy_pid <= 1:
        return 0, []
    children_map, stats_map = _build_proc_tree()
    if agy_pid not in stats_map:
        return 0, []

    # Exclude this hook process and its own ancestors up to agy_pid.
    hook_ancestors: set[int] = set()
    cur = os.getpid()
    while cur > 1 and cur not in hook_ancestors:
        hook_ancestors.add(cur)
        st = stats_map.get(cur)
        if st is None:
            break
        cur = st[0]

    direct_shells: list[tuple[int, int, str]] = []
    total_ticks = 0
    agy_pgrp = stats_map[agy_pid][1]
    for cpid, cpgrp, ccomm, cticks in children_map.get(agy_pid, ()):
        if cpid in hook_ancestors:
            continue
        # Count Setpgid child trees (even when GNU bash -c exec'd python3/cargo/sleep directly)
        # while ignoring shared-pgrp internal helpers (e.g. agy-statusline) unless shell-named.
        if cpgrp == agy_pgrp and ccomm not in SHELL_COMMS:
            continue
        direct_shells.append((cpid, cpgrp, ccomm))
        queue = [cpid]
        visited = {cpid}
        total_ticks += cticks
        while queue:
            node = queue.pop()
            for gpid, _gpgrp, _gcomm, gticks in children_map.get(node, ()):
                if gpid not in visited:
                    visited.add(gpid)
                    total_ticks += gticks
                    queue.append(gpid)
    return total_ticks, direct_shells


def _collect_descendants(root_pid: int, agy_pid: int) -> list[int]:
    """Return descendants of root_pid (post-order), excluding agy_pid and self."""
    children_map, _ = _build_proc_tree()
    ordered: list[int] = []
    visited = {root_pid, agy_pid, os.getpid()}

    def dfs(pid: int) -> None:
        for cpid, _pgrp, _comm, _ticks in children_map.get(pid, ()):
            if cpid not in visited:
                visited.add(cpid)
                dfs(cpid)
                ordered.append(cpid)

    dfs(root_pid)
    return ordered


def kill_child_shell_safely(agy_pid: int, child_pid: int, child_pgrp: int) -> bool:
    """Surgically terminate child shell without ever signaling agy_pid or agy_pgrp."""
    if child_pid <= 1 or child_pid == agy_pid or child_pid == os.getpid():
        return False
    agy_info = _read_proc_stat(agy_pid)
    if agy_info is None:
        return False
    agy_pgrp = agy_info[2]

    if child_pgrp > 1 and child_pgrp != agy_pgrp:
        try:
            os.killpg(child_pgrp, signal.SIGTERM)
            return True
        except ProcessLookupError:
            return False
        except PermissionError:
            return False

    sent = False
    for dpid in _collect_descendants(child_pid, agy_pid):
        with contextlib.suppress(ProcessLookupError, PermissionError, OSError):
            os.kill(dpid, signal.SIGTERM)
            sent = True
    with contextlib.suppress(ProcessLookupError, PermissionError, OSError):
        os.kill(child_pid, signal.SIGTERM)
        sent = True
    return sent


# ---------------------------------------------------------------------------
# Tool canonicalization, error normalization, workspace state, & DB helpers
# ---------------------------------------------------------------------------


def canonicalize_tool_call(tname: str, targs: dict[str, Any]) -> tuple[bool, str]:
    """Return (exempt_from_identical_block, args_sha256_prefix16)."""
    if tname in EXEMPT_LOOP_TOOLS:
        return True, ""
    if tname == "manage_task" and str(targs.get("Action") or "").lower() in {"status", "list"}:
        return True, ""

    if tname == "run_command":
        cmd = str(targs.get("CommandLine") or "")
        norm_cmd = RTK_PREFIX_RE.sub("", cmd).strip()
        canon: Any = {"cmd": norm_cmd}
    elif tname in {"read_file", "view_file"}:
        canon = {
            "Path": targs.get("Path") or targs.get("AbsolutePath") or "",
            "StartLine": targs.get("StartLine"),
            "EndLine": targs.get("EndLine"),
            "ByteOffset": targs.get("ByteOffset"),
        }
    else:
        canon = targs

    blob = json.dumps(canon, sort_keys=True, ensure_ascii=True, separators=(",", ":"))
    digest = hashlib.sha256(blob.encode("utf-8", errors="replace")).hexdigest()[:16]
    return False, digest


def normalize_error_sig(err: str) -> str:
    txt = (err or "").strip().lower()
    txt = UUID_RE.sub("#", txt)
    txt = ISO_TS_RE.sub("#", txt)
    txt = HEX_RE.sub("#", txt)
    txt = NUM_RE.sub("#", txt)
    txt = WS_RE.sub(" ", txt).strip()
    return txt[:160]


def is_mutating_shell_command(cmd: str) -> bool:
    """Return True only when `cmd` clearly mutates filesystem or git state."""
    stripped = RTK_PREFIX_RE.sub("", (cmd or "").strip())
    if not stripped:
        return False
    unquoted = QUOTED_STR_RE.sub(" _Q_ ", stripped)
    if FILE_REDIRECT_RE.search(unquoted):
        return True
    for seg in re.split(r"(?:&&|\|\||;|\|)", unquoted):
        tokens = seg.strip().split()
        while tokens and (
            ("=" in tokens[0] and not tokens[0].startswith("-"))
            or Path(tokens[0]).name in {"sudo", "nohup", "time", "nice", "command"}
        ):
            tokens.pop(0)
        if not tokens:
            continue
        verb = Path(tokens[0]).name
        rest = tokens[1:]
        if verb in MUTATING_CMD_VERBS or verb.endswith(".sh"):
            return True
        if verb in {"sed", "perl"}:
            if any(t == "--in-place" or (t.startswith("-") and not t.startswith("--") and "i" in t[1:]) for t in rest):
                return True
        elif verb == "git":
            sub = ""
            skip_next = False
            for t in rest:
                if skip_next:
                    skip_next = False
                    continue
                if t in {"-C", "-c", "--git-dir", "--work-tree"}:
                    skip_next = True
                    continue
                if t.startswith("-"):
                    continue
                sub = t
                break
            if sub in MUTATING_GIT_SUBS:
                return True
        elif verb in {"npm", "pnpm", "yarn", "bun", "pip", "pip3", "uv", "cargo", "go"}:
            sub = next((t for t in rest if not t.startswith("-")), "")
            if sub in MUTATING_PKG_SUBS:
                return True
    return False


def is_readonly_command(cmd: str) -> bool:
    return not is_mutating_shell_command(cmd)


ENV_SECRET_FILE_RE = re.compile(r"^\.env(?:\..+)?$")
ENV_TEMPLATE_FILE_RE = re.compile(r"^\.env\.(?:example|sample|template)$")
SHORT_FORCE_FLAG_RE = re.compile(r"^-[a-zA-Z]*f[a-zA-Z]*$")
SHORT_ALL_FLAG_RE = re.compile(r"^-[a-zA-Z]*a[a-zA-Z]*$")


def _split_unquoted_command_segments(cmd: str) -> list[tuple[str, str]]:
    """Return [(raw_seg, masked_seg)] split on unquoted shell separators."""
    cleaned = re.sub(r"<<[-~]?\s*['\"]?(\w+)['\"]?.*?(?:\n\1\b|$)", " <<HEREDOC ", cmd, flags=re.S)
    cleaned = re.sub(r"\s-(?:c|e)\s+(?:'[^']*'|\"(?:\\.|[^\"])*\")", " -c __INLINE__ ", cleaned, flags=re.S)
    masked = QUOTED_STR_RE.sub(
        lambda m: (m.group(0)[0] + (" " * (len(m.group(0)) - 2)) + m.group(0)[-1]) if len(m.group(0)) >= 2 else m.group(0),
        cleaned,
    )
    segs: list[tuple[str, str]] = []
    start = 0
    for m in re.finditer(r"&&|\|\||[;\n|]", masked):
        raw_part = cleaned[start : m.start()].strip()
        masked_part = masked[start : m.start()].strip()
        if raw_part:
            segs.append((raw_part, masked_part))
        start = m.end()
    raw_tail = cleaned[start:].strip()
    masked_tail = masked[start:].strip()
    if raw_tail:
        segs.append((raw_tail, masked_tail))
    return segs


def _tokenize_segment(raw_seg: str, masked_seg: str) -> tuple[list[str], set[str]]:
    """Strip wrappers/env assignments from a segment and return (tokens, env_assignments)."""
    try:
        tokens = shlex.split(raw_seg)
    except ValueError:
        tokens = masked_seg.split()
    env_assigns: set[str] = set()
    idx = 0
    while idx < len(tokens):
        tok = tokens[idx]
        if "=" in tok and not tok.startswith("-") and re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", tok):
            env_assigns.add(tok)
            idx += 1
            continue
        base = Path(tok).name
        if base == "rtk":
            idx += 1
            if idx < len(tokens) and tokens[idx] == "bypass":
                idx += 1
            continue
        if base in {"sudo", "nohup", "time", "nice", "command", "env", "stdbuf", "setsid"}:
            idx += 1
            while idx < len(tokens) and tokens[idx].startswith("-"):
                idx += 1
            continue
        if base == "timeout":
            idx += 1
            while idx < len(tokens) and tokens[idx].startswith("-"):
                idx += 1
            if idx < len(tokens) and re.match(r"^\d+[smhd]?$", tokens[idx]):
                idx += 1
            continue
        break
    return tokens[idx:], env_assigns


def _run_git_readonly(git_dir: str, *args: str) -> tuple[bool, str]:
    try:
        proc = subprocess.run(
            ["git", "--no-optional-locks", "-C", git_dir, *args],
            capture_output=True,
            text=True,
            timeout=1.5,
        )
        return proc.returncode == 0, proc.stdout
    except Exception:
        return False, ""


def check_git_safety_guard(cmd: str, cwd: str, state: dict[str, Any]) -> str:
    """Return a block reason string if `cmd` violates a safety guard, else empty string."""
    if not state.get("git_guard", True) or not (cmd or "").strip():
        return ""
    cur_dir = cwd or os.getcwd()
    for raw_seg, masked_seg in _split_unquoted_command_segments(cmd):
        tokens, env_assigns = _tokenize_segment(raw_seg, masked_seg)
        if not tokens:
            continue
        verb = Path(tokens[0]).name
        if verb == "cd" and len(tokens) >= 2 and not tokens[1].startswith("-"):
            cand = Path(tokens[1]).expanduser()
            cur_dir = str((cand if cand.is_absolute() else (Path(cur_dir) / cand)).resolve())
            continue
        if verb != "git":
            continue

        git_dir = cur_dir
        i = 1
        while i < len(tokens):
            tok = tokens[i]
            if tok == "-C" and i + 1 < len(tokens):
                cand = Path(tokens[i + 1]).expanduser()
                git_dir = str((cand if cand.is_absolute() else (Path(git_dir) / cand)).resolve())
                i += 2
                continue
            if tok in {"-c", "--git-dir", "--work-tree"}:
                i += 2
                continue
            if tok.startswith("-"):
                i += 1
                continue
            break
        if i >= len(tokens):
            continue
        sub = tokens[i]
        rest = tokens[i + 1 :]

        # Rule 1: Block committing staged secret .env* files
        if sub == "commit" and not any(a in {"-h", "--help"} for a in rest):
            ok_staged, staged_out = _run_git_readonly(git_dir, "diff", "--cached", "--name-only")
            candidates: list[str] = staged_out.splitlines() if ok_staged else []
            if any(a in {"-a", "--all"} or SHORT_ALL_FLAG_RE.match(a) for a in rest):
                ok_mod, mod_out = _run_git_readonly(git_dir, "diff", "--name-only")
                if ok_mod:
                    candidates.extend(mod_out.splitlines())
            bad_envs: list[str] = []
            for rel_path in candidates:
                p_str = rel_path.strip()
                if not p_str:
                    continue
                bname = Path(p_str).name
                if ENV_SECRET_FILE_RE.match(bname) and not ENV_TEMPLATE_FILE_RE.match(bname):
                    if p_str not in bad_envs:
                        bad_envs.append(p_str)
            if bad_envs:
                listed = ", ".join(bad_envs[:5])
                restore_args = " ".join(shlex.quote(p) for p in bad_envs[:5])
                return (
                    f"[Watchdog Git Guard] Blocked `git commit`: secret environment file staged ({listed}). "
                    f"Unstage it with `git restore --staged {restore_args}` before committing."
                )

        # Rule 2: Block raw `git push --force` / `-f` / `+refspec`
        if sub == "push" and "AGY_GIT_GUARD_ALLOW_FORCE=1" not in env_assigns:
            if any(
                a == "--force" or SHORT_FORCE_FLAG_RE.match(a) or (a.startswith("+") and len(a) > 1)
                for a in rest
            ):
                return (
                    "[Watchdog Git Guard] Blocked raw `git push --force`. Never force-push without explicit user "
                    "confirmation; if rewriting a feature branch is requested, use `git push --force-with-lease` "
                    "(or prefix with `AGY_GIT_GUARD_ALLOW_FORCE=1` if explicitly approved)."
                )

        # Rule 3: Block `git reset --hard` / `git clean -f` when uncommitted work would be lost
        is_hard_reset = sub == "reset" and "--hard" in rest
        is_force_clean = sub == "clean" and any(a == "--force" or SHORT_FORCE_FLAG_RE.match(a) for a in rest)
        if (is_hard_reset or is_force_clean) and "AGY_GIT_GUARD_ALLOW_RESET=1" not in env_assigns:
            ok_st, st_out = _run_git_readonly(git_dir, "status", "--porcelain")
            if ok_st and st_out:
                dirty: list[str] = []
                for ln in st_out.splitlines():
                    if not ln.strip():
                        continue
                    is_untracked = ln.startswith("?? ")
                    if (is_hard_reset and not is_untracked) or (is_force_clean and is_untracked):
                        dirty.append(ln[3:].strip())
                if dirty:
                    preview = ", ".join(dirty[:5])
                    if len(dirty) > 5:
                        preview += f" (+{len(dirty) - 5} more)"
                    return (
                        f"[Watchdog Git Guard] Blocked `git {sub}` that would permanently discard uncommitted work "
                        f"({preview}). Restore specific files (`git checkout -- <file>`) or, if the user explicitly "
                        "approved discarding all work, prefix with `AGY_GIT_GUARD_ALLOW_RESET=1`."
                    )
    return ""


def extract_cwd(payload: dict[str, Any]) -> str:
    cwd = str(payload.get("cwd") or "").strip()
    if cwd:
        return cwd
    wpaths = payload.get("workspacePaths")
    if isinstance(wpaths, list) and wpaths:
        return str(wpaths[0] or "").strip()
    return ""


def compute_ws_sig(mutation_seq: int, cwd: str) -> str:
    g_hash = ""
    if cwd and Path(cwd).is_dir():
        try:
            proc = subprocess.run(
                ["git", "-C", cwd, "status", "--porcelain", "--no-optional-locks"],
                capture_output=True,
                timeout=0.08,
            )
            if proc.returncode == 0:
                g_hash = hashlib.sha256(proc.stdout).hexdigest()[:8]
        except Exception:
            pass
    return f"{mutation_seq}:{g_hash}"


def resolve_edited_file_path(targs: dict[str, Any], cwd: str) -> Path | None:
    raw = str(targs.get("Path") or targs.get("TargetFile") or targs.get("AbsolutePath") or "").strip()
    if not raw:
        return None
    p = Path(raw).expanduser()
    if not p.is_absolute() and cwd:
        p = Path(cwd) / p
    return p


def read_db_active_indices(cid: str) -> tuple[bool, set[int], set[int], set[int]]:
    """Return (db_ok, running_idxs, generating_idxs, waiting_idxs) using idx_steps_status."""
    db_path = CLI_DATA_DIR / "conversations" / f"{cid}.db"
    if not db_path.is_file():
        return False, set(), set(), set()
    running: set[int] = set()
    generating: set[int] = set()
    waiting: set[int] = set()
    try:
        with contextlib.closing(sqlite3.connect(f"file:{db_path}?mode=ro", uri=True, timeout=0.4)) as conn:
            for idx, status in conn.execute(
                "SELECT idx, status FROM steps WHERE status IN (?, ?, ?)",
                (STEP_STATUS_RUNNING, STEP_STATUS_GENERATING, STEP_STATUS_WAITING),
            ):
                s_idx = int(idx)
                st = int(status)
                if st == STEP_STATUS_RUNNING:
                    running.add(s_idx)
                elif st == STEP_STATUS_GENERATING:
                    generating.add(s_idx)
                elif st == STEP_STATUS_WAITING:
                    waiting.add(s_idx)
        return True, running, generating, waiting
    except Exception:
        return False, set(), set(), set()


def is_step_running_in_db(cid: str, step_idx: int) -> bool | None:
    """Return True if status==2 (RUNNING), False if finished/other, None if DB/row absent."""
    db_path = CLI_DATA_DIR / "conversations" / f"{cid}.db"
    if not db_path.is_file():
        return None
    try:
        with contextlib.closing(sqlite3.connect(f"file:{db_path}?mode=ro", uri=True, timeout=0.4)) as conn:
            row = conn.execute("SELECT status FROM steps WHERE idx = ?", (step_idx,)).fetchone()
            if row is None:
                return None
            return int(row[0]) == STEP_STATUS_RUNNING
    except Exception:
        return None


def find_running_bg_tasks(cid: str) -> list[dict[str, Any]]:
    """
    Parse the tail of brain/<cid>/.system_generated/logs/transcript_full.jsonl for
    backgrounded run_command steps, excluding Timer: schedules, IsDaemon=true tasks,
    and tasks already finished in conversations/<cid>.db.
    """
    tpath = CLI_DATA_DIR / "brain" / cid / ".system_generated" / "logs" / "transcript_full.jsonl"
    if not tpath.is_file():
        return []
    try:
        size = tpath.stat().st_size
        with tpath.open("rb") as fh:
            if size > TRANSCRIPT_TAIL_BYTES:
                fh.seek(size - TRANSCRIPT_TAIL_BYTES)
                fh.readline()  # discard partial first line after seek
            lines = fh.read().decode("utf-8", errors="replace").splitlines()
    except Exception:
        return []

    db_ok, running_idxs, _, _ = read_db_active_indices(cid)

    records: list[dict[str, Any]] = []
    planners: dict[int, list[dict[str, Any]]] = {}
    for raw in lines:
        if not raw.strip():
            continue
        try:
            d = json.loads(raw)
        except Exception:
            continue
        if not isinstance(d, dict):
            continue
        records.append(d)
        if d.get("type") == "PLANNER_RESPONSE" and isinstance(d.get("step_index"), int):
            tcalls = d.get("tool_calls")
            if isinstance(tcalls, list):
                planners[int(d["step_index"])] = tcalls

    tasks: list[dict[str, Any]] = []
    for d in records:
        if d.get("status") != "RUNNING":
            continue
        step_idx = d.get("step_index")
        if not isinstance(step_idx, int):
            continue
        if db_ok and step_idx not in running_idxs:
            continue
        content = str(d.get("content") or "")
        m_id = BG_TASK_ID_RE.search(content)
        if not m_id:
            continue
        task_id = m_id.group(1)
        m_desc = TASK_DESC_RE.search(content)
        desc = m_desc.group(1).strip() if m_desc else ""
        if desc.startswith("Timer:"):
            continue

        # Check matching PLANNER_RESPONSE tool call for non-run_command or IsDaemon=true.
        exempt = False
        best_p = max((p for p in planners if p < step_idx), default=None)
        if best_p is not None:
            tcalls = planners[best_p]
            offset = step_idx - best_p - 1
            tc = tcalls[offset] if 0 <= offset < len(tcalls) else (tcalls[0] if len(tcalls) == 1 else None)
            if isinstance(tc, dict):
                tname = str(tc.get("name") or "")
                targs = tc.get("args") if isinstance(tc.get("args"), dict) else {}
                is_daemon = targs.get("IsDaemon")
                if tname and tname != "run_command":
                    exempt = True
                if is_daemon is True or str(is_daemon).lower() == "true":
                    exempt = True
        if exempt:
            continue

        tasks.append({"step_idx": step_idx, "task_id": task_id, "desc": desc})
    return tasks


def read_task_log_tail(cid: str, step_idx: int, max_bytes: int = 512) -> tuple[int, str]:
    log_path = CLI_DATA_DIR / "brain" / cid / ".system_generated" / "tasks" / f"task-{step_idx}.log"
    if not log_path.is_file():
        return 0, ""
    try:
        size = log_path.stat().st_size
        with log_path.open("rb") as fh:
            if size > max_bytes:
                fh.seek(size - max_bytes)
            tail = fh.read().decode("utf-8", errors="replace")
        return size, tail
    except Exception:
        return 0, ""


def resolve_transcript_path(cid: str, payload: dict[str, Any] | None = None) -> Path | None:
    if isinstance(payload, dict):
        raw_tp = str(payload.get("transcriptPath") or "").strip().strip('"')
        if raw_tp:
            p = Path(raw_tp).expanduser()
            if p.is_file():
                return p
    logs_dir = CLI_DATA_DIR / "brain" / cid / ".system_generated" / "logs"
    for fname in ("transcript.jsonl", "transcript_full.jsonl"):
        cand = logs_dir / fname
        if cand.is_file():
            return cand
    return None


def _parse_iso_epoch(raw: Any) -> float:
    s = str(raw or "").strip()
    if not s:
        return 0.0
    if s.endswith("Z"):
        s = s[:-1] + "+00:00"
    with contextlib.suppress(Exception):
        d = dt.datetime.fromisoformat(s)
        if d.tzinfo is None:
            d = d.replace(tzinfo=dt.timezone.utc)
        return d.timestamp()
    return 0.0


def inspect_transcript_turn(cid: str, payload: dict[str, Any] | None = None) -> tuple[int, int, float]:
    """Return (turn_planner_steps, total_planner_steps, latest_user_prompt_epoch) from transcript.jsonl."""
    tpath = resolve_transcript_path(cid, payload)
    if tpath is None or not tpath.is_file():
        return 0, 0, 0.0
    turn_planner_steps = 0
    total_planner_steps = 0
    latest_prompt_epoch = 0.0
    with contextlib.suppress(Exception):
        with tpath.open("r", encoding="utf-8", errors="replace") as fh:
            for line in fh:
                line = line.strip()
                if not line:
                    continue
                try:
                    entry = json.loads(line)
                except Exception:
                    continue
                if not isinstance(entry, dict):
                    continue
                etype = str(entry.get("type") or "")
                if etype == "USER_INPUT":
                    turn_planner_steps = 0
                    ts = _parse_iso_epoch(entry.get("created_at"))
                    if ts > 0.0:
                        latest_prompt_epoch = ts
                elif etype == "PLANNER_RESPONSE":
                    turn_planner_steps += 1
                    total_planner_steps += 1
    return turn_planner_steps, total_planner_steps, latest_prompt_epoch


def _trunc_str(text: str, limit: int) -> str:
    if limit <= 1 or len(text) <= limit:
        return text[:limit] if limit <= 1 else text
    return text[: limit - 1].rstrip() + "…"


def clean_prompt_preview(raw: str, limit: int = 80) -> str:
    """Strip wrapper tags and return a single concise line of the user prompt."""
    cleaned = USER_REQ_CLEAN_RE.sub("", raw or "")
    for line in cleaned.splitlines():
        s = WS_RE.sub(" ", line).strip()
        if s:
            return _trunc_str(s, limit)
    return ""


def _shorten_target_path(raw: str, cwd: str = "") -> str:
    """Shorten a file path relative to cwd or home without touching the filesystem."""
    p = Path(raw)
    if cwd:
        cwd_p = Path(cwd)
        with contextlib.suppress(ValueError):
            rel = str(p.relative_to(cwd_p))
            return rel if rel != "." else (cwd_p.name or ".")
    with contextlib.suppress(ValueError):
        rel_home = str(p.relative_to(Path.home()))
        return f"~/{rel_home}" if rel_home != "." else "~"
    return raw


def summarize_tool_target(tname: str, targs: dict[str, Any], cwd: str = "") -> str:
    """Pure string formatter summarizing tool target arguments (never reads files or env)."""
    if not isinstance(targs, dict):
        return ""
    if tname == "run_command":
        summary = WS_RE.sub(" ", str(targs.get("toolSummary") or "")).strip()
        cmd = RTK_PREFIX_RE.sub("", str(targs.get("CommandLine") or "").strip())
        cmd = INLINE_ENV_ASSIGN_RE.sub(r"\1=***", cmd)
        cmd = WS_RE.sub(" ", cmd).strip()
        if summary and cmd:
            cmd_short = _trunc_str(cmd, 49)
            return _trunc_str(f"{summary} ({cmd_short})", 78)
        return _trunc_str(summary or cmd, 78)

    if tname in MUTATING_FILE_TOOLS or tname in {"read_file", "view_file"}:
        raw = str(targs.get("Path") or targs.get("TargetFile") or targs.get("AbsolutePath") or "").strip()
        if not raw:
            return ""
        short = _shorten_target_path(raw, cwd)
        if tname in {"read_file", "view_file"}:
            s_line = targs.get("StartLine")
            e_line = targs.get("EndLine")
            if s_line is not None and str(s_line).strip():
                if e_line is not None and str(e_line).strip():
                    short = f"{short}:{s_line}-{e_line}"
                else:
                    short = f"{short}:{s_line}"
        return _trunc_str(short, 78)

    if tname in {"grep_search", "find_by_name"}:
        q = WS_RE.sub(" ", str(targs.get("Query") or targs.get("Pattern") or "")).strip()
        return _trunc_str(q, 64)
    if tname == "invoke_subagent":
        t_type = str(targs.get("TypeName") or "subagent").strip()
        role = WS_RE.sub(" ", str(targs.get("Role") or "")).strip()
        return _trunc_str(f"{t_type}: {role}".strip(": "), 72)
    if tname == "manage_task":
        act = str(targs.get("Action") or "").strip()
        tid = str(targs.get("TaskId") or "").split("/")[-1].strip()
        return _trunc_str(f"{act} {tid}".strip(), 64)
    if tname == "send_message":
        rec = str(targs.get("Recipient") or "").strip()
        return f"-> {rec[:8]}" if rec else ""
    if tname == "search_web":
        q = WS_RE.sub(" ", str(targs.get("query") or "")).strip()
        return _trunc_str(q, 64)
    if tname == "schedule":
        dur = targs.get("DurationSeconds")
        cron = targs.get("CronExpression")
        if dur is not None and str(dur).strip():
            return f"{dur}s"
        return _trunc_str(str(cron or "").strip(), 48)
    if tname == "exit_plan_mode":
        return "hand off plan"
    return ""


def _extract_spawned_subagent_cid(cid: str, payload: dict[str, Any] | None, step_idx: int | None) -> str:
    """Parse transcript tail to extract newly created subagent conversationId."""
    tpath = resolve_transcript_path(cid, payload)
    if not tpath or not tpath.is_file():
        return ""
    try:
        size = tpath.stat().st_size
        with tpath.open("rb") as fh:
            if size > 16384:
                fh.seek(size - 16384)
                fh.readline()
            lines = fh.read().decode("utf-8", errors="replace").splitlines()
    except Exception:
        return ""

    fallback_cid = ""
    for raw in reversed(lines):
        if not raw.strip():
            continue
        try:
            d = json.loads(raw)
        except Exception:
            continue
        if not isinstance(d, dict) or d.get("type") != "GENERIC":
            continue
        content = str(d.get("content") or "")
        m = SUBAGENT_CID_RE.search(content)
        if not m:
            continue
        found = sanitize_cid(m.group(1))
        if not found or found == cid:
            continue
        if step_idx is not None and d.get("step_index") == step_idx:
            return found
        if not fallback_cid and "Created the following subagent:" in content and step_idx is None:
            fallback_cid = found
    return fallback_cid


def _reset_error_hits(sess: dict[str, Any]) -> None:
    sess["consecutive_same_err"] = {"sig": "", "count": 0, "sample": "", "warned_at": 0}


def _record_error_hit(sess: dict[str, Any], sample_raw: str) -> None:
    txt = (sample_raw or "").strip()
    if not txt:
        return
    sig = normalize_error_sig(txt)
    if not sig:
        sig = "nonzero_exit"
    err_state = sess.get("consecutive_same_err") or {}
    if sig == err_state.get("sig"):
        err_state["count"] = int(err_state.get("count") or 0) + 1
    else:
        err_state = {
            "sig": sig,
            "count": 1,
            "sample": txt.splitlines()[0][:180],
            "warned_at": 0,
        }
    sess["consecutive_same_err"] = err_state


def _extract_meaningful_error_line(raw_err: str, content: str, exit_rc: int) -> str:
    if raw_err:
        first = raw_err.strip().splitlines()[0].strip()
        if first:
            return first[:180]
    skip_prefixes = (
        "Created At:",
        "Completed At:",
        "Command output:",
        "Command exited with code ",
        "A pre-tool hook changed",
        "The tool's output was truncated",
        "Encountered error in step execution:",
    )
    for ln in content.splitlines():
        s = ln.strip()
        if not s or s.startswith(skip_prefixes):
            continue
        return s[:180]
    return f"Command exited with code {exit_rc}"


def sync_transcript_errors(
    sess: dict[str, Any],
    cid: str,
    payload: dict[str, Any] | None = None,
    advance_only: bool = False,
) -> None:
    """
    Sync consecutive error streaks from `transcript.jsonl` (`GENERIC` steps), catching
    non-zero `run_command` exits where `agy` delivers `error=""` to `PostToolUse`.
    """
    tpath = resolve_transcript_path(cid, payload)
    if not tpath or not tpath.is_file():
        return
    try:
        size = tpath.stat().st_size
        with tpath.open("rb") as fh:
            if size > 32768:
                fh.seek(size - 32768)
                fh.readline()
            lines = fh.read().decode("utf-8", errors="replace").splitlines()
    except Exception:
        return

    parsed: list[dict[str, Any]] = []
    max_step = -1
    for raw in lines:
        if not raw.strip():
            continue
        try:
            d = json.loads(raw)
        except Exception:
            continue
        if isinstance(d, dict) and isinstance(d.get("step_index"), int):
            parsed.append(d)
            if int(d["step_index"]) > max_step:
                max_step = int(d["step_index"])

    if not parsed:
        return

    if advance_only:
        cur = int(sess.get("err_cursor_step_idx") or -1)
        if max_step > cur:
            sess["err_cursor_step_idx"] = max_step
        _reset_error_hits(sess)
        return

    cursor = int(sess.get("err_cursor_step_idx") or -1)
    for d in parsed:
        s_idx = int(d["step_index"])
        if s_idx <= cursor:
            continue
        if d.get("type") != "GENERIC":
            cursor = s_idx
            continue
        status = str(d.get("status") or "")
        content = str(d.get("content") or "")
        raw_err = str(d.get("error") or "").strip()
        m_rc = CMD_EXIT_CODE_RE.search(content)
        exit_rc = int(m_rc.group(1)) if m_rc else 0
        if status == "ERROR" or exit_rc != 0:
            sample = _extract_meaningful_error_line(raw_err, content, exit_rc)
            _record_error_hit(sess, sample)
        else:
            _reset_error_hits(sess)
            if (sess.get("last_alert") or {}).get("kind") == "loop":
                sess["last_alert"] = None
        cursor = s_idx
    sess["err_cursor_step_idx"] = cursor


def send_desktop_alert(title: str, body: str) -> None:
    notifier = shutil.which("notify-send")
    if not notifier:
        return
    with contextlib.suppress(Exception):
        subprocess.Popen(
            [notifier, "-u", "critical", "-a", "agy-watch", title, body],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
            close_fds=True,
        )


def ensure_watcher_running() -> None:
    """Spawn detached daemon-loop only if watcher.lock is not currently held."""
    ensure_dirs()
    try:
        with WATCHER_LOCK.open("a+", encoding="utf-8") as fh:
            try:
                fcntl.flock(fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                return
            fcntl.flock(fh.fileno(), fcntl.LOCK_UN)
    except Exception:
        return

    with contextlib.suppress(Exception):
        subprocess.Popen(
            [sys.executable, str(Path(__file__).resolve()), "daemon-loop"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
            close_fds=True,
        )


def _probe_presence_lock(cid: str) -> tuple[bool, bool]:
    """Return (lock_file_exists, is_currently_locked_by_agy)."""
    lock_path = CLI_DATA_DIR / "presence" / f"{cid}.lock"
    if not lock_path.is_file():
        return False, False
    try:
        with lock_path.open("r+", encoding="utf-8") as fh:
            try:
                fcntl.flock(fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                return True, True
            fcntl.flock(fh.fileno(), fcntl.LOCK_UN)
            return True, False
    except Exception:
        return True, False


def is_presence_locked(cid: str) -> bool:
    """Return True only when presence/<cid>.lock exists and IS locked by a live agy."""
    exists, locked = _probe_presence_lock(cid)
    return exists and locked


def check_presence_unlocked(cid: str) -> bool:
    """Return True only when presence/<cid>.lock exists and is NOT locked by a live agy."""
    exists, locked = _probe_presence_lock(cid)
    return exists and not locked


# ---------------------------------------------------------------------------
# Hook Handlers
# ---------------------------------------------------------------------------


def _read_hook_payload() -> dict[str, Any]:
    raw = sys.stdin.read() or "{}"
    data = json.loads(raw)
    return data if isinstance(data, dict) else {}


def _is_subagent_turn(cid: str, sess: dict[str, Any], payload: dict[str, Any], user_in: str) -> bool:
    """Return True when the hook fired inside a subagent or internal worker session."""
    if sess.get("parent_cid") or sess.get("role"):
        return True
    if payload.get("parentConversationId") or payload.get("isSubagent"):
        return True
    if user_in.lstrip().startswith("[AGY_INTERNAL_WORKER]"):
        return True
    brain_root = CLI_DATA_DIR / "brain"
    if brain_root.is_dir():
        with contextlib.suppress(OSError):
            if any(brain_root.glob(f"*/.system_generated/subagents/{cid}.json")):
                return True
    return False


def _is_margin_enabled() -> bool:
    """Return True when the Margin plugin is enabled in Antigravity config."""
    forced = os.environ.get("AGY_WATCHDOG_MARGIN_ENABLED")
    if forced is not None:
        return forced == "1"
    cfg_path = Path.home() / ".gemini" / "config" / "config.json"
    if cfg_path.is_file():
        with contextlib.suppress(Exception):
            cfg = json.loads(cfg_path.read_text(encoding="utf-8"))
            plugins = cfg.get("plugins")
            if isinstance(plugins, dict) and "margin" in plugins:
                entry = plugins.get("margin")
                if isinstance(entry, dict) and "enabled" in entry:
                    return bool(entry["enabled"])
    return any(
        (Path.home() / ".gemini" / prod / "mcp" / "margin_margin").is_dir()
        for prod in ("antigravity", "antigravity-cli", "antigravity-ide")
    )


def _resolve_brain_dir(cid: str, payload: dict[str, Any] | None = None) -> Path | None:
    """Resolve `<brain>` directory for `cid` across transcript path, CLI_DATA_DIR, and home products."""
    tp = resolve_transcript_path(cid, payload)
    if tp and tp.parent.name == "logs" and tp.parent.parent.name == ".system_generated":
        return tp.parent.parent.parent
    cli_brain = CLI_DATA_DIR / "brain" / cid
    if cli_brain.is_dir():
        return cli_brain
    gemini_dir = Path.home() / ".gemini"
    for prod in ("antigravity-cli", "antigravity", "antigravity-ide"):
        cand = gemini_dir / prod / "brain" / cid
        if cand.is_dir():
            return cand
    return cli_brain if cid else None


def _margin_topics_worker_path() -> Path | None:
    for cand in (
        Path.home() / ".gemini" / "config" / "plugins" / "margin" / "lib" / "topics-worker.mjs",
        Path(__file__).resolve().parent.parent / "config" / "plugins" / "margin" / "lib" / "topics-worker.mjs",
    ):
        if cand.is_file():
            return cand
    return None


def _spawn_margin_topics(brain: Path | None) -> None:
    """Spawn detached `topics-worker.mjs` at 0 ms without waiting for model completion."""
    if not brain or os.environ.get("AGY_WATCHDOG_NO_TOPICS_SPAWN") == "1":
        return
    if not (brain / ".system_generated" / "logs" / "transcript.jsonl").is_file():
        return
    worker = _margin_topics_worker_path()
    node_bin = shutil.which("node")
    if not worker or not node_bin:
        return
    env = os.environ.copy()
    env["AGY_HOOK_INTERNAL"] = "1"
    with contextlib.suppress(Exception):
        subprocess.Popen(
            [node_bin, str(worker), "--brain", str(brain)],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
            env=env,
        )


def _margin_outcome_worker_path() -> Path | None:
    for cand in (
        Path.home() / ".gemini" / "config" / "plugins" / "margin" / "lib" / "outcome-worker.mjs",
        Path(__file__).resolve().parent.parent / "config" / "plugins" / "margin" / "lib" / "outcome-worker.mjs",
    ):
        if cand.is_file():
            return cand
    return None


def _spawn_margin_outcome(brain: Path | None) -> None:
    """Spawn detached `outcome-worker.mjs --spawn` at 0 ms without blocking Stop."""
    if not brain or os.environ.get("AGY_WATCHDOG_NO_OUTCOME_SPAWN") == "1":
        return
    if not (brain / ".system_generated" / "logs" / "transcript.jsonl").is_file():
        return
    worker = _margin_outcome_worker_path()
    node_bin = shutil.which("node")
    if not worker or not node_bin:
        return
    env = os.environ.copy()
    env["AGY_HOOK_INTERNAL"] = "1"
    with contextlib.suppress(Exception):
        subprocess.Popen(
            [node_bin, str(worker), "--brain", str(brain), "--spawn"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
            env=env,
        )


def _intent_updated_since(brain: Path | None, since_epoch: float) -> bool:
    """Return True when `intent.json` was written at or after `since_epoch`."""
    if not brain or since_epoch <= 0.0:
        return False
    ip = brain / ".system_generated" / "margin" / "intent.json"
    if not ip.is_file():
        return False
    try:
        data = json.loads(ip.read_text(encoding="utf-8"))
    except Exception:
        return False
    if not isinstance(data, dict):
        return False
    upd = _parse_iso_epoch(data.get("updatedAt"))
    if upd > 0.0:
        return upd >= since_epoch - 2.0
    with contextlib.suppress(OSError):
        return ip.stat().st_mtime >= since_epoch - 2.0
    return False


def _prev_turn_missed_margin(
    brain: Path | None,
    prev_turn_started: float,
    prev_had_user_in: bool,
) -> bool:
    """Detect whether an immediately preceding turn never reported to `margin_intent`."""
    if not prev_had_user_in or prev_turn_started <= 0.0:
        return False
    return not _intent_updated_since(brain, prev_turn_started)


def cmd_pre_invocation_hook(_args: argparse.Namespace) -> int:
    if os.environ.get("AGY_HOOK_INTERNAL") == "1":
        print("{}")
        return 0
    try:
        payload = _read_hook_payload()
        cid = sanitize_cid(str(payload.get("conversationId") or ""))
        if not cid:
            print("{}")
            return 0
        state = load_state()
        if not state.get("enabled", True):
            print("{}")
            return 0

        now = time.time()
        mono_ns = time.monotonic_ns()
        user_in = str(payload.get("lastUserInput") or "")
        agy_pid = find_ancestor_agy_pid()

        inject_msgs: list[str] = []
        thrash_triggered = False

        with file_lock(session_lock_path(cid)):
            sess = load_session(cid)
            if agy_pid:
                sess["agy_pid"] = agy_pid
            _sync_session_meta(sess, payload)
            proj = str(sess.get("project") or "")

            t_turn_steps, t_total_steps, t_prompt_epoch = inspect_transcript_turn(cid, payload)
            prev_turn_started = float(sess.get("turn_started_epoch") or 0.0)
            prev_had_user_in = bool(sess.get("last_user_input"))
            is_new_user_turn = bool(user_in and user_in != sess.get("last_user_input"))
            if is_new_user_turn:
                sess["last_user_input"] = user_in
                sess["turn_tool_count"] = 0
                sess["turn_step_count"] = max(1, t_turn_steps + 1)
                sess["total_steps"] = max(int(sess.get("total_steps") or 0) + 1, t_total_steps + 1)
                sess["turn_started_epoch"] = now
                sess["warned_step_45"] = False
                sess["margin_step2_nudged"] = False
                sess["recent_calls"] = []
                sess["file_hashes"] = {}
                sess["stop_bounced_tasks"] = []
                sess["last_alert"] = None
                sync_transcript_errors(sess, cid, payload, advance_only=True)
            else:
                sess["turn_step_count"] = max(int(sess.get("turn_step_count") or 0) + 1, t_turn_steps + 1)
                sess["total_steps"] = max(int(sess.get("total_steps") or 0) + 1, t_total_steps + 1)
                if float(sess.get("turn_started_epoch") or 0.0) <= 0.0:
                    sess["turn_started_epoch"] = t_prompt_epoch if t_prompt_epoch > 0.0 else now
                _clear_sync_stall_alert(sess)
                sync_transcript_errors(sess, cid, payload, advance_only=False)

            is_sub = _is_subagent_turn(cid, sess, payload, user_in)
            margin_on = not is_sub and _is_margin_enabled()
            margin_brain = _resolve_brain_dir(cid, payload) if margin_on else None
            if is_new_user_turn and margin_on:
                _spawn_margin_topics(margin_brain)
            if margin_on and os.environ.get("AGY_WATCHDOG_NO_MARGIN_NUDGE") != "1":
                if is_new_user_turn:
                    if _prev_turn_missed_margin(margin_brain, prev_turn_started, prev_had_user_in):
                        inject_msgs.append(
                            f"Margin missed last turn: call `call_mcp_tool` (`margin_margin` / `margin_intent`) with `conversation_id: \"{cid}\"`, `wants` (terse wants <=60ch), `take` (pre-work stance, never answer), `steps` (short steps <=40ch), and `now: 1` FIRST (including Plan Mode)."
                        )
                    else:
                        inject_msgs.append(
                            f"Margin Overview (Step 1): call `call_mcp_tool` (`margin_margin` / `margin_intent`) with `conversation_id: \"{cid}\"`, `wants` (terse wants <=60ch), `take` (pre-work stance, never answer), `steps` (short steps <=40ch), and `now: 1` FIRST before other tools (Plan Mode ok; schema in rules)."
                        )
                elif (
                    int(sess.get("turn_step_count") or 0) == 2
                    and not sess.get("margin_step2_nudged")
                    and not _intent_updated_since(margin_brain, float(sess.get("turn_started_epoch") or 0.0))
                ):
                    sess["margin_step2_nudged"] = True
                    inject_msgs.append(
                        f"Margin Overview missing: call `call_mcp_tool` (`margin_margin` / `margin_intent`) with `conversation_id: \"{cid}\"`, `wants` (terse wants <=60ch), `take`, `steps` (short steps <=40ch), `now: 1` now."
                    )

            sess["inflight_tools"] = {}
            sess["phase"] = "model"
            sess["model_started_mono_ns"] = mono_ns
            sess["model_started_epoch"] = now

            pending = sess.get("pending_guidance") or []
            if pending:
                inject_msgs.extend(str(m) for m in pending if m)
                sess["pending_guidance"] = []

            err_state = sess.get("consecutive_same_err") or {}
            err_cnt = int(err_state.get("count") or 0)
            warned_at = int(err_state.get("warned_at") or 0)
            if err_cnt >= 3 and warned_at < err_cnt:
                err_state["warned_at"] = err_cnt
                sess["consecutive_same_err"] = err_state
                sample = str(err_state.get("sample") or "repeated error")
                inject_msgs.append(
                    f"Thrash Circuit-Breaker ({err_cnt} consecutive identical errors: `{sample}`). "
                    "Stop repeating the failing command/edit; diagnose the underlying root cause before trying again."
                )
                sess["last_alert"] = {"kind": "loop", "detail": f"err×{err_cnt}", "ts": now}
                thrash_triggered = True

            turn_steps = int(sess.get("turn_step_count") or 0)
            turn_tools = int(sess.get("turn_tool_count") or 0)
            if (turn_steps >= 25 or turn_tools >= 45) and not sess.get("warned_step_45"):
                sess["warned_step_45"] = True
                inject_msgs.append(
                    f"Turn step check: {turn_steps} model steps ({turn_tools} tool calls) executed in this turn. "
                    "Verify forward progress and avoid unnecessary retry loops."
                )

            step_for_event = turn_steps
            save_session(cid, sess)

        if thrash_triggered:
            update_state_field(lambda st: st.__setitem__("thrash_pivots", int(st.get("thrash_pivots") or 0) + 1))
            log_line(f"[THRASH] cid={cid[:8]} err_count={err_cnt}")

        append_event(cid=cid, event="model_start", step_idx=step_for_event, project=proj)
        ensure_watcher_running()

        if inject_msgs:
            sys_msg = "<watchdog>\n" + "\n".join(f"- {m}" for m in inject_msgs) + "\n</watchdog>"
            out: dict[str, Any] = {
                "injectSteps": [
                    {"systemMessage": {"systemMessage": sys_msg}},
                ]
            }
            print(json.dumps(out))
        else:
            print("{}")
        return 0
    except Exception:
        print("{}")
        return 0


def cmd_pre_tool_hook(_args: argparse.Namespace) -> int:
    if os.environ.get("AGY_HOOK_INTERNAL") == "1":
        print(json.dumps({"decision": "allow"}))
        return 0
    try:
        payload = _read_hook_payload()
        cid = sanitize_cid(str(payload.get("conversationId") or ""))
        if not cid:
            print(json.dumps({"decision": "allow"}))
            return 0
        state = load_state()
        if not state.get("enabled", True):
            print(json.dumps({"decision": "allow"}))
            return 0

        tcall = payload.get("toolCall") if isinstance(payload.get("toolCall"), dict) else {}
        tname = str(tcall.get("name") or "")
        targs = tcall.get("args") if isinstance(tcall.get("args"), dict) else {}
        step_idx = payload.get("stepIdx") if isinstance(payload.get("stepIdx"), int) else None
        tool_id = str(tcall.get("id") or f"step_{step_idx if step_idx is not None else 0}")

        now = time.time()
        mono_ns = time.monotonic_ns()
        cwd = extract_cwd(payload)
        agy_pid = find_ancestor_agy_pid()
        exempt, args_hash = canonicalize_tool_call(tname, targs)

        if tname == "run_command":
            guard_cwd = cwd or str(load_session(cid).get("cwd") or "")
            git_block = check_git_safety_guard(str(targs.get("CommandLine") or ""), guard_cwd, state)
            if git_block:
                proj_g = Path(guard_cwd).name if guard_cwd else ""
                target_g = summarize_tool_target(tname, targs, guard_cwd)
                update_state_field(lambda st: st.__setitem__("git_guards_blocked", int(st.get("git_guards_blocked") or 0) + 1))
                append_event(
                    cid=cid,
                    event="git_guard_blocked",
                    step_idx=step_idx,
                    tool_id=tool_id,
                    tool=tname,
                    status="denied",
                    detail=git_block[:120],
                    project=proj_g,
                    target=target_g,
                )
                log_line(f"[GIT-GUARD] cid={cid[:8]} step={step_idx} reason={git_block[:120]}")
                print(json.dumps({"decision": "deny", "reason": git_block}))
                return 0

        model_dur_ms: int | None = None
        blocked_reason = ""
        proj = ""
        target = ""

        with file_lock(session_lock_path(cid)):
            sess = load_session(cid)
            if agy_pid:
                sess["agy_pid"] = agy_pid
            cwd = _sync_session_meta(sess, payload)
            proj = str(sess.get("project") or "")
            target = summarize_tool_target(tname, targs, cwd)

            if sess.get("phase") == "model" and int(sess.get("model_started_mono_ns") or 0) > 0:
                model_dur_ms = max(0, (mono_ns - int(sess["model_started_mono_ns"])) // 1_000_000)

            ws_sig = compute_ws_sig(int(sess.get("mutation_seq") or 0), cwd)
            if not exempt and args_hash:
                recent = list(sess.get("recent_calls") or [])
                matches = sum(
                    1
                    for item in recent[-6:]
                    if item.get("tool") == tname
                    and item.get("args_hash") == args_hash
                    and item.get("ws_sig") == ws_sig
                )
                if matches >= 2:
                    sess["last_alert"] = {"kind": "loop", "detail": f"{tname}×3", "ts": now}
                    sess["phase"] = "idle"
                    save_session(cid, sess)
                    blocked_reason = (
                        f"[Watchdog] Blocked 3rd identical `{tname}` call with no workspace state change. "
                        "Do not repeat the exact same call; inspect why earlier attempts did not solve it and change approach."
                    )
                else:
                    recent.append({"tool": tname, "args_hash": args_hash, "ws_sig": ws_sig})
                    sess["recent_calls"] = recent[-20:]

            if not blocked_reason:
                sess["phase"] = "tool"
                inflight = sess.get("inflight_tools") or {}
                inflight[tool_id] = {
                    "started_mono_ns": mono_ns,
                    "started_epoch": now,
                    "step_idx": step_idx,
                    "name": tname,
                    "target": target,
                    "args_hash": args_hash,
                    "notified": False,
                }
                sess["inflight_tools"] = inflight
                save_session(cid, sess)

        if model_dur_ms is not None:
            append_event(cid=cid, event="model_done", duration_ms=model_dur_ms, status="ok", project=proj)

        if blocked_reason:
            update_state_field(lambda st: st.__setitem__("loops_blocked", int(st.get("loops_blocked") or 0) + 1))
            append_event(
                cid=cid,
                event="loop_blocked",
                step_idx=step_idx,
                tool_id=tool_id,
                tool=tname,
                status="denied",
                detail="3x identical call with unchanged ws_sig",
                project=proj,
                target=target,
            )
            log_line(f"[LOOP-BLOCK] cid={cid[:8]} tool={tname} step={step_idx}")
            print(json.dumps({"decision": "deny", "reason": blocked_reason}))
            return 0

        append_event(cid=cid, event="tool_start", step_idx=step_idx, tool_id=tool_id, tool=tname, project=proj, target=target)
        ensure_watcher_running()
        print(json.dumps({"decision": "allow"}))
        return 0
    except Exception:
        print(json.dumps({"decision": "allow"}))
        return 0


def cmd_post_tool_hook(_args: argparse.Namespace) -> int:
    if os.environ.get("AGY_HOOK_INTERNAL") == "1":
        print("{}")
        return 0
    try:
        payload = _read_hook_payload()
        cid = sanitize_cid(str(payload.get("conversationId") or ""))
        if not cid:
            print("{}")
            return 0
        state = load_state()
        if not state.get("enabled", True):
            print("{}")
            return 0

        tcall = payload.get("toolCall") if isinstance(payload.get("toolCall"), dict) else {}
        tname = str(tcall.get("name") or "")
        targs = tcall.get("args") if isinstance(tcall.get("args"), dict) else {}
        step_idx = payload.get("stepIdx") if isinstance(payload.get("stepIdx"), int) else None
        tool_id = str(tcall.get("id") or f"step_{step_idx if step_idx is not None else 0}")
        err = str(payload.get("error") or "").strip()
        cwd = extract_cwd(payload)
        mono_ns = time.monotonic_ns()

        duration_ms = 0
        proj = ""
        target = ""
        with file_lock(session_lock_path(cid)):
            sess = load_session(cid)
            cwd = _sync_session_meta(sess, payload)
            proj = str(sess.get("project") or "")
            inflight = sess.get("inflight_tools") or {}
            tinfo = inflight.pop(tool_id, None)
            if tinfo is None and step_idx is not None:
                for k, v in list(inflight.items()):
                    if isinstance(v, dict) and v.get("step_idx") == step_idx:
                        tinfo = inflight.pop(k)
                        break
            if isinstance(tinfo, dict) and int(tinfo.get("started_mono_ns") or 0) > 0:
                duration_ms = max(0, (mono_ns - int(tinfo["started_mono_ns"])) // 1_000_000)

            target = summarize_tool_target(tname, targs, cwd)
            if not target and isinstance(tinfo, dict):
                target = str(tinfo.get("target") or "")

            sess["inflight_tools"] = inflight
            sess["turn_tool_count"] = int(sess.get("turn_tool_count") or 0) + 1
            if int(sess.get("turn_step_count") or 0) <= 0:
                sess["turn_step_count"] = 1
            if float(sess.get("turn_started_epoch") or 0.0) <= 0.0:
                sess["turn_started_epoch"] = time.time()
            sess["last_step"] = {
                "event": "tool_done",
                "step_idx": step_idx,
                "tool": tname,
                "target": target,
                "duration_ms": duration_ms,
                "status": "error" if err else "ok",
                "ts": time.time(),
            }
            if not inflight and (sess.get("last_alert") or {}).get("kind") == "stall":
                sess["last_alert"] = None

            if err:
                _record_error_hit(sess, err)
                if step_idx is not None:
                    sess["err_cursor_step_idx"] = max(int(sess.get("err_cursor_step_idx") or -1), step_idx)
            else:
                if tname != "run_command":
                    _reset_error_hits(sess)
                    if not inflight and (sess.get("last_alert") or {}).get("kind") == "loop":
                        sess["last_alert"] = None
                    if step_idx is not None:
                        sess["err_cursor_step_idx"] = max(int(sess.get("err_cursor_step_idx") or -1), step_idx)
                if tname in MUTATING_FILE_TOOLS:
                    sess["mutation_seq"] = int(sess.get("mutation_seq") or 0) + 1
                    fpath = resolve_edited_file_path(targs, cwd)
                    if fpath and fpath.is_file():
                        with contextlib.suppress(Exception):
                            if fpath.stat().st_size <= MAX_HASH_FILE_BYTES:
                                digest = hashlib.sha256(fpath.read_bytes()).hexdigest()
                                fhashes = sess.get("file_hashes") or {}
                                hist = list(fhashes.get(str(fpath)) or [])
                                hist.append(digest)
                                hist = hist[-4:]
                                fhashes[str(fpath)] = hist
                                sess["file_hashes"] = fhashes
                                if len(hist) >= 3 and hist[-1] == hist[-3] and hist[-1] != hist[-2]:
                                    pending = list(sess.get("pending_guidance") or [])
                                    pending.append(
                                        f"Edit oscillation (ABAB_HASH_FLIP) detected on `{fpath.name}`: "
                                        "content reverted to its earlier state. Re-check requirements before editing again."
                                    )
                                    sess["pending_guidance"] = pending
                elif tname == "run_command":
                    cmd = str(targs.get("CommandLine") or "")
                    if is_mutating_shell_command(cmd):
                        sess["mutation_seq"] = int(sess.get("mutation_seq") or 0) + 1

            save_session(cid, sess)

        if tname == "invoke_subagent" and not err:
            child_cid = _extract_spawned_subagent_cid(cid, payload, step_idx)
            role = WS_RE.sub(" ", str(targs.get("Role") or targs.get("TypeName") or "")).strip()[:72]
            if child_cid and child_cid != cid:
                with file_lock(session_lock_path(child_cid)):
                    child_sess = load_session(child_cid)
                    child_sess["parent_cid"] = cid
                    if role:
                        child_sess["role"] = role
                    if cwd and not child_sess.get("cwd"):
                        child_sess["cwd"] = cwd
                    if proj and not child_sess.get("project"):
                        child_sess["project"] = proj
                    save_session(child_cid, child_sess)

        append_event(
            cid=cid,
            event="tool_done",
            step_idx=step_idx,
            tool_id=tool_id,
            tool=tname,
            duration_ms=duration_ms,
            status="error" if err else "ok",
            detail=err.splitlines()[0][:160] if err else "",
            project=proj,
            target=target,
        )
        print("{}")
        return 0
    except Exception:
        print("{}")
        return 0


def cmd_stop_hook(_args: argparse.Namespace) -> int:
    if os.environ.get("AGY_HOOK_INTERNAL") == "1":
        print(json.dumps({"decision": "stop"}))
        return 0
    try:
        payload = _read_hook_payload()
        cid = sanitize_cid(str(payload.get("conversationId") or ""))
        if not cid:
            print(json.dumps({"decision": "stop"}))
            return 0
        state = load_state()
        if not state.get("enabled", True):
            print(json.dumps({"decision": "stop"}))
            return 0

        term_reason = str(payload.get("terminationReason") or "")
        fully_idle = payload.get("fullyIdle")
        continuation_active = bool(payload.get("continuationActive"))
        mono_ns = time.monotonic_ns()
        agy_pid = find_ancestor_agy_pid()

        model_dur_ms: int | None = None
        bounced_tasks: list[str] = []
        proj = ""
        with file_lock(session_lock_path(cid)):
            sess = load_session(cid)
            if agy_pid:
                sess["agy_pid"] = agy_pid
            else:
                agy_pid = sess.get("agy_pid")
            _sync_session_meta(sess, payload)
            proj = str(sess.get("project") or "")
            if sess.get("phase") == "model" and int(sess.get("model_started_mono_ns") or 0) > 0:
                model_dur_ms = max(0, (mono_ns - int(sess["model_started_mono_ns"])) // 1_000_000)

            sess["inflight_tools"] = {}
            _clear_sync_stall_alert(sess)
            if fully_idle is not False:
                sess["phase"] = "idle"
                save_session(cid, sess)
            else:
                sess["phase"] = "bg_wait"
                bounced_tasks = list(sess.get("stop_bounced_tasks") or [])
                save_session(cid, sess)

        if model_dur_ms is not None:
            append_event(cid=cid, event="model_done", duration_ms=model_dur_ms, status="ok", project=proj)
        append_event(
            cid=cid,
            event="turn_stop",
            status=term_reason or "UNKNOWN",
            detail=f"fullyIdle={fully_idle}",
            project=proj,
        )

        if fully_idle is not False:
            if not _is_subagent_turn(cid, sess, payload, str(sess.get("last_user_input") or "")) and _is_margin_enabled():
                _spawn_margin_outcome(_resolve_brain_dir(cid, payload))
            print(json.dumps({"decision": "stop"}))
            return 0

        ensure_watcher_running()

        if term_reason == "NO_TOOL_CALL" and not continuation_active:
            candidates = [t for t in find_running_bg_tasks(cid) if t["task_id"] not in bounced_tasks]
            if candidates:
                target = candidates[-1]
                step_idx = int(target["step_idx"])
                task_id = str(target["task_id"])
                bounce_limit = max(1, int(state.get("stop_idle_bounce_s", 12)))
                stdin_limit = max(1, min(bounce_limit, int(state.get("stdin_prompt_s", 4))))

                size_0, tail_0 = read_task_log_tail(cid, step_idx)
                cpu_0, _shells = sample_agy_child_shells(agy_pid)
                start_mono = time.monotonic()

                while True:
                    db_running = is_step_running_in_db(cid, step_idx)
                    if db_running is False:
                        print(json.dumps({"decision": "stop"}))
                        return 0

                    size_now, tail_now = read_task_log_tail(cid, step_idx)
                    cpu_now, _ = sample_agy_child_shells(agy_pid)
                    if size_now > size_0 or cpu_now > cpu_0:
                        print(json.dumps({"decision": "stop"}))
                        return 0

                    elapsed = time.monotonic() - start_mono
                    prompt_hit = bool(STDIN_PROMPT_RE.search(tail_now or tail_0))
                    if prompt_hit and elapsed >= stdin_limit:
                        break
                    if elapsed >= bounce_limit:
                        break
                    time.sleep(min(1.0, max(0.1, bounce_limit - elapsed)))

                with file_lock(session_lock_path(cid)):
                    sess = load_session(cid)
                    bounced = list(sess.get("stop_bounced_tasks") or [])
                    if task_id not in bounced:
                        bounced.append(task_id)
                    sess["stop_bounced_tasks"] = bounced[-20:]
                    sess["last_alert"] = {"kind": "stall", "detail": f"task-{step_idx} bounced", "ts": time.time()}
                    save_session(cid, sess)

                update_state_field(lambda st: st.__setitem__("hangs_bounced", int(st.get("hangs_bounced") or 0) + 1))
                append_event(
                    cid=cid,
                    event="stop_bounce",
                    step_idx=step_idx,
                    tool="run_command",
                    status="bounced",
                    detail=f"{task_id} idle/stdin prompt",
                    project=proj,
                )
                log_line(f"[STOP-BOUNCE] cid={cid[:8]} task={task_id} prompt={prompt_hit}")

                snippet = (tail_now or tail_0 or "(no output)").strip().splitlines()
                tail_preview = " | ".join(snippet[-3:])[-240:]
                reason = (
                    "<watchdog>\n"
                    f"Background command `{task_id}` has produced 0% CPU activity and 0 new output bytes "
                    f"for {int(round(elapsed))}s (log tail: `{tail_preview}`).\n"
                    f"Do not wait passively: call `manage_task` with `Action: \"status\"` and `TaskId: \"{task_id}\"` "
                    "to inspect it, then send input (`send_input`) or terminate it (`kill`) and re-run non-interactively.\n"
                    "</watchdog>"
                )
                print(json.dumps({"decision": "continue", "reason": reason}))
                return 0

        print(json.dumps({"decision": "stop"}))
        return 0
    except Exception:
        print(json.dumps({"decision": "stop"}))
        return 0


# ---------------------------------------------------------------------------
# Detached Self-Exiting Hang Watcher (`daemon-loop`)
# ---------------------------------------------------------------------------


def cmd_daemon_loop(_args: argparse.Namespace) -> int:
    ensure_dirs()
    try:
        lock_fh = WATCHER_LOCK.open("a+", encoding="utf-8")
        try:
            fcntl.flock(lock_fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            lock_fh.close()
            return 0
    except Exception:
        return 0

    try:
        lock_fh.seek(0)
        lock_fh.truncate()
        lock_fh.write(f"{os.getpid()}\n")
        lock_fh.flush()

        poll_s = float(os.environ.get("AGY_WATCHDOG_POLL_S") or 3.0)
        idle_limit = int(os.environ.get("AGY_WATCHDOG_IDLE_TICKS") or 5)
        idle_ticks = 0

        task_tracker: dict[tuple[str, int], dict[str, Any]] = {}
        tool_notified: set[tuple[str, str]] = set()
        model_notified: set[tuple[str, float]] = set()

        while True:
            state = load_state()
            if not state.get("enabled", True):
                break

            any_active = False
            now = time.time()

            for sfile in sorted(SESSIONS_DIR.glob("*.json")):
                cid = sanitize_cid(sfile.stem)
                if not cid:
                    continue

                if check_presence_unlocked(cid):
                    with file_lock(session_lock_path(cid)):
                        sess = load_session(cid)
                        if sess.get("phase") != "idle" or sess.get("inflight_tools"):
                            sess["phase"] = "idle"
                            sess["inflight_tools"] = {}
                            save_session(cid, sess)
                            append_event(cid=cid, event="session_closed", status="unlocked")
                            log_line(f"[SESSION-CLOSED] cid={cid[:8]} presence lock released")
                    continue

                presence_exists = (CLI_DATA_DIR / "presence" / f"{cid}.lock").is_file()
                if not presence_exists:
                    with file_lock(session_lock_path(cid)):
                        sess_chk = load_session(cid)
                        chk_pid = sess_chk.get("agy_pid")
                        if isinstance(chk_pid, int) and chk_pid > 1 and _read_proc_stat(chk_pid) is None:
                            if sess_chk.get("phase") != "idle" or sess_chk.get("inflight_tools"):
                                sess_chk["phase"] = "idle"
                                sess_chk["inflight_tools"] = {}
                                save_session(cid, sess_chk)
                                append_event(cid=cid, event="session_closed", status="pid_gone")
                                log_line(f"[SESSION-CLOSED] cid={cid[:8]} agy_pid={chk_pid} gone")
                            continue

                _db_ok, running_idxs, generating_idxs, waiting_idxs = read_db_active_indices(cid)
                has_waiting = bool(waiting_idxs)
                has_running_db = bool(running_idxs)
                has_generating_db = bool(generating_idxs)

                with file_lock(session_lock_path(cid)):
                    sess = load_session(cid)

                if has_waiting:
                    if (sess.get("last_alert") or {}).get("kind") == "stall":
                        with file_lock(session_lock_path(cid)):
                            sess = load_session(cid)
                            if (sess.get("last_alert") or {}).get("kind") == "stall":
                                sess["last_alert"] = None
                                save_session(cid, sess)
                    continue

                phase = str(sess.get("phase") or "idle")
                agy_pid = sess.get("agy_pid") if isinstance(sess.get("agy_pid"), int) else None
                inflight = dict(sess.get("inflight_tools") or {})

                if phase in {"model", "tool", "bg_wait"} or has_running_db or has_generating_db:
                    any_active = True

                # 1. Sync tool / MCP stall check (prune completed, backgrounded, or permission-rejected steps)
                stale_ids: list[str] = []
                for tool_id, tinfo in inflight.items():
                    if not isinstance(tinfo, dict):
                        stale_ids.append(tool_id)
                        continue
                    s_idx = tinfo.get("step_idx")
                    has_task_log = False
                    if isinstance(s_idx, int):
                        tlog = CLI_DATA_DIR / "brain" / cid / ".system_generated" / "tasks" / f"task-{s_idx}.log"
                        has_task_log = tlog.is_file()
                    if has_task_log or (
                        _db_ok
                        and isinstance(s_idx, int)
                        and s_idx not in running_idxs
                        and (now - float(tinfo.get("started_epoch") or now)) >= 3.0
                    ):
                        stale_ids.append(tool_id)
                        continue
                    if (has_running_db or phase == "tool") and not has_task_log:
                        elapsed = now - float(tinfo.get("started_epoch") or now)
                        if elapsed >= float(state.get("tool_warn_s", 60)):
                            tname = str(tinfo.get("name") or "tool")
                            with file_lock(session_lock_path(cid)):
                                sess = load_session(cid)
                                sess["last_alert"] = {
                                    "kind": "stall",
                                    "detail": f"{tname} {int(elapsed)}s",
                                    "ts": now,
                                }
                                save_session(cid, sess)
                            if (cid, tool_id) not in tool_notified:
                                tool_notified.add((cid, tool_id))
                                send_desktop_alert(
                                    "Antigravity Watchdog — Sync Tool Stall",
                                    f"Session {cid[:8]}: `{tname}` running {int(elapsed)}s (press Esc if wedged).",
                                )
                                append_event(
                                    cid=cid,
                                    event="tool_stall_alert",
                                    step_idx=s_idx if isinstance(s_idx, int) else None,
                                    tool_id=tool_id,
                                    tool=tname,
                                    detail=f"{int(elapsed)}s",
                                )
                                log_line(f"[TOOL-STALL] cid={cid[:8]} tool={tname} {int(elapsed)}s")

                if stale_ids:
                    with file_lock(session_lock_path(cid)):
                        sess = load_session(cid)
                        cur_inf = dict(sess.get("inflight_tools") or {})
                        for sid in stale_ids:
                            cur_inf.pop(sid, None)
                        sess["inflight_tools"] = cur_inf
                        if not cur_inf:
                            _clear_sync_stall_alert(sess)
                        save_session(cid, sess)

                # 2. Model generation stall check
                model_started_epoch = float(sess.get("model_started_epoch") or 0.0)
                if has_generating_db and model_started_epoch > 0:
                    m_elapsed = now - model_started_epoch
                    if m_elapsed >= float(state.get("model_warn_s", 90)):
                        with file_lock(session_lock_path(cid)):
                            sess = load_session(cid)
                            sess["last_alert"] = {
                                "kind": "stall",
                                "detail": f"model {int(m_elapsed)}s",
                                "ts": now,
                            }
                            save_session(cid, sess)
                        if m_elapsed >= 180 and (cid, model_started_epoch) not in model_notified:
                            model_notified.add((cid, model_started_epoch))
                            send_desktop_alert(
                                "Antigravity Watchdog — Model Stream Stall",
                                f"Session {cid[:8]}: model response open {int(m_elapsed)}s.",
                            )
                            append_event(cid=cid, event="model_stall_alert", detail=f"{int(m_elapsed)}s")
                            log_line(f"[MODEL-STALL] cid={cid[:8]} {int(m_elapsed)}s")

                # 3. Late background task stall check + surgical child-shell recovery
                bg_tasks = find_running_bg_tasks(cid) if (phase == "bg_wait" or has_running_db) else []
                if bg_tasks:
                    any_active = True
                    cpu_ticks, child_shells = sample_agy_child_shells(agy_pid)
                    for task in bg_tasks:
                        s_idx = int(task["step_idx"])
                        size, tail = read_task_log_tail(cid, s_idx)
                        key = (cid, s_idx)
                        tr = task_tracker.get(key)
                        if tr is None:
                            task_tracker[key] = {
                                "last_size": size,
                                "last_cpu": cpu_ticks,
                                "last_active_ts": now,
                                "notified": False,
                                "killed": False,
                            }
                            continue

                        if size > tr["last_size"] or cpu_ticks > tr["last_cpu"]:
                            tr["last_size"] = size
                            tr["last_cpu"] = cpu_ticks
                            tr["last_active_ts"] = now
                            tr["notified"] = False
                            if (sess.get("last_alert") or {}).get("kind") == "stall":
                                with file_lock(session_lock_path(cid)):
                                    sess = load_session(cid)
                                    if (sess.get("last_alert") or {}).get("kind") == "stall":
                                        sess["last_alert"] = None
                                        save_session(cid, sess)
                            continue

                        stall_s = now - float(tr["last_active_ts"])
                        prompt_hit = bool(STDIN_PROMPT_RE.search(tail))
                        threshold = 20.0 if prompt_hit else float(state.get("bg_hang_s", 90))
                        if stall_s >= threshold and not tr["killed"]:
                            with file_lock(session_lock_path(cid)):
                                sess = load_session(cid)
                                sess["last_alert"] = {
                                    "kind": "stall",
                                    "detail": f"task-{s_idx} {int(stall_s)}s",
                                    "ts": now,
                                }
                                save_session(cid, sess)

                            if not tr["notified"]:
                                tr["notified"] = True
                                send_desktop_alert(
                                    "Antigravity Watchdog — Background Task Stall",
                                    f"Session {cid[:8]}: task-{s_idx} stalled {int(stall_s)}s (0% CPU, 0 bytes).",
                                )
                                append_event(
                                    cid=cid,
                                    event="late_stall_alert",
                                    step_idx=s_idx,
                                    tool="run_command",
                                    detail=f"{int(stall_s)}s prompt={prompt_hit}",
                                )
                                log_line(f"[LATE-STALL] cid={cid[:8]} task-{s_idx} {int(stall_s)}s")

                            if state.get("auto_kill_late_hangs", True) and agy_pid and len(child_shells) == 1:
                                c_pid, c_pgrp, _comm = child_shells[0]
                                if kill_child_shell_safely(agy_pid, c_pid, c_pgrp):
                                    tr["killed"] = True
                                    with file_lock(session_lock_path(cid)):
                                        sess = load_session(cid)
                                        pending = list(sess.get("pending_guidance") or [])
                                        pending.append(
                                            f"Background task `task-{s_idx}` stalled at 0% CPU and 0 new output "
                                            f"for {int(stall_s)}s and was terminated by Watchdog so the session could "
                                            "recover. Inspect its partial output and re-run with non-interactive flags."
                                        )
                                        sess["pending_guidance"] = pending
                                        save_session(cid, sess)
                                    update_state_field(
                                        lambda st: st.__setitem__(
                                            "late_hangs_killed", int(st.get("late_hangs_killed") or 0) + 1
                                        )
                                    )
                                    append_event(
                                        cid=cid,
                                        event="late_hang_killed",
                                        step_idx=s_idx,
                                        tool="run_command",
                                        status="sigterm",
                                        detail=f"child_pid={c_pid} stall_s={int(stall_s)}",
                                    )
                                    log_line(f"[AUTO-KILL] cid={cid[:8]} task-{s_idx} child_pid={c_pid}")

            if any_active:
                idle_ticks = 0
            else:
                idle_ticks += 1
                if idle_ticks >= idle_limit:
                    break

            time.sleep(poll_s)
    finally:
        with contextlib.suppress(Exception):
            fcntl.flock(lock_fh.fileno(), fcntl.LOCK_UN)
        with contextlib.suppress(Exception):
            lock_fh.close()
    return 0


# ---------------------------------------------------------------------------
# User CLI Commands
# ---------------------------------------------------------------------------


def _is_watcher_alive() -> bool:
    if not WATCHER_LOCK.is_file():
        return False
    try:
        with WATCHER_LOCK.open("r+", encoding="utf-8") as fh:
            try:
                fcntl.flock(fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                return True
            fcntl.flock(fh.fileno(), fcntl.LOCK_UN)
            return False
    except Exception:
        return False


def cmd_status(_args: argparse.Namespace) -> int:
    st = load_state()
    alive = _is_watcher_alive()
    print(
        f"agy-watch: {'ENABLED' if st.get('enabled', True) else 'DISABLED'} "
        f"| auto_kill={bool(st.get('auto_kill_late_hangs', True))} "
        f"| watcher={'RUNNING' if alive else 'idle (stopped)'}"
    )
    print(
        f"thresholds: model={st['model_warn_s']}s tool={st['tool_warn_s']}s "
        f"stdin={st['stdin_prompt_s']}s bounce={st['stop_idle_bounce_s']}s bg_hang={st['bg_hang_s']}s"
    )
    print(
        f"counters: loops_blocked={st['loops_blocked']} thrash_pivots={st['thrash_pivots']} "
        f"hangs_bounced={st['hangs_bounced']} late_hangs_killed={st['late_hangs_killed']}"
    )
    if SESSIONS_DIR.is_dir():
        sessions = sorted(SESSIONS_DIR.glob("*.json"), key=lambda p: p.stat().st_mtime, reverse=True)[:8]
        if sessions:
            print("recent sessions:")
            for sp in sessions:
                s = load_session(sp.stem)
                alert = s.get("last_alert")
                alert_s = f" alert={alert['kind']}:{alert['detail']}" if isinstance(alert, dict) else ""
                el_s = ""
                ts_turn = float(s.get("turn_started_epoch") or 0.0)
                if ts_turn > 0.0:
                    el_s = f" turn_elapsed={int(max(0.0, time.time() - ts_turn))}s"
                print(
                    f"  {sp.stem[:8]} phase={s.get('phase')} "
                    f"steps={int(s.get('turn_step_count') or 0)}/{int(s.get('total_steps') or 0)} "
                    f"turn_tools={s.get('turn_tool_count')}{el_s} "
                    f"inflight={len(s.get('inflight_tools') or {})}{alert_s}"
                )
    return 0


def _make_styler(mode: str) -> dict[str, str]:
    use_color = mode == "always" or (mode == "auto" and sys.stdout.isatty() and "NO_COLOR" not in os.environ)
    if not use_color:
        return {k: "" for k in ("bold", "dim", "red", "yellow", "green", "cyan", "blue", "magenta", "reset")}
    return {
        "bold": "\033[1m",
        "dim": "\033[2m",
        "red": "\033[31m",
        "yellow": "\033[33m",
        "green": "\033[32m",
        "cyan": "\033[36m",
        "blue": "\033[34m",
        "magenta": "\033[35m",
        "reset": "\033[0m",
    }


def _probe_all_presence_locks() -> dict[str, bool]:
    """Return {cid: is_locked} across all presence/*.lock files."""
    pdir = CLI_DATA_DIR / "presence"
    if not pdir.is_dir():
        return {}
    result: dict[str, bool] = {}
    for lp in pdir.glob("*.lock"):
        cid = sanitize_cid(lp.stem)
        if not cid:
            continue
        result[cid] = is_presence_locked(cid)
    return result


def collect_session_snapshots(include_closed: bool = False, cid_prefix: str = "") -> list[dict[str, Any]]:
    """Build normalized, hierarchically ordered session snapshots across active & recent agy sessions."""
    presence_state = _probe_all_presence_locks()
    any_presence_files = bool(presence_state)

    candidate_cids: set[str] = set()
    if SESSIONS_DIR.is_dir():
        for sp in SESSIONS_DIR.glob("*.json"):
            scid = sanitize_cid(sp.stem)
            if scid:
                candidate_cids.add(scid)
    for pcid, is_locked in presence_state.items():
        if is_locked or include_closed:
            candidate_cids.add(pcid)

    now = time.time()
    items: list[dict[str, Any]] = []
    for cid in sorted(candidate_cids):
        sess = load_session(cid)
        presence_file = cid in presence_state
        presence_locked = presence_state.get(cid, False)

        if presence_file and not presence_locked and not include_closed:
            continue

        _db_ok, running_idxs, generating_idxs, waiting_idxs = read_db_active_indices(cid)
        agy_pid = sess.get("agy_pid") if isinstance(sess.get("agy_pid"), int) else None
        pid_alive = bool(agy_pid and agy_pid > 1 and _read_proc_stat(agy_pid) is not None)

        if presence_file:
            kind = "main"
        elif sess.get("parent_cid") or sess.get("role") or any_presence_files:
            kind = "subagent"
        else:
            kind = "main"

        if presence_file:
            live = presence_locked
        else:
            live = (
                sess.get("phase") in {"model", "tool", "bg_wait"}
                or bool(running_idxs or generating_idxs or waiting_idxs)
            ) and (pid_alive or agy_pid is None)

        if not live and not include_closed:
            continue

        raw_inflight = sess.get("inflight_tools") or {}
        inflight_sortable: list[tuple[float, dict[str, Any]]] = []
        if isinstance(raw_inflight, dict):
            for tool_id, tinfo in raw_inflight.items():
                if not isinstance(tinfo, dict):
                    continue
                st_epoch = float(tinfo.get("started_epoch") or now)
                inflight_sortable.append(
                    (
                        st_epoch,
                        {
                            "tool_id": str(tool_id),
                            "step_idx": tinfo.get("step_idx"),
                            "name": str(tinfo.get("name") or ""),
                            "target": str(tinfo.get("target") or ""),
                            "elapsed_s": round(max(0.0, now - st_epoch), 1),
                        },
                    )
                )
        inflight_sortable.sort(key=lambda pair: pair[0])
        inflight_list = [entry for _ts, entry in inflight_sortable]

        bg_tasks: list[dict[str, Any]] = []
        if live and (sess.get("phase") in {"bg_wait", "tool"} or running_idxs):
            for t in find_running_bg_tasks(cid):
                s_idx = int(t["step_idx"])
                log_bytes, raw_tail = read_task_log_tail(cid, s_idx, max_bytes=384)
                tail_lines = [ln.strip() for ln in raw_tail.splitlines() if ln.strip()]
                log_tail = _trunc_str(WS_RE.sub(" ", tail_lines[-1]), 96) if tail_lines else ""
                bg_tasks.append(
                    {
                        "step_idx": s_idx,
                        "task_id": str(t.get("task_id") or ""),
                        "desc": _trunc_str(WS_RE.sub(" ", str(t.get("desc") or "")).strip(), 78),
                        "log_bytes": log_bytes,
                        "log_tail": log_tail,
                    }
                )

        last_alert = sess.get("last_alert") if isinstance(sess.get("last_alert"), dict) else None
        model_started = float(sess.get("model_started_epoch") or 0.0)
        updated_at = float(sess.get("updated_at") or 0.0)
        if not updated_at and session_path(cid).is_file():
            with contextlib.suppress(Exception):
                updated_at = session_path(cid).stat().st_mtime

        elapsed_s = 0.0
        if live and waiting_idxs:
            st_name = "waiting_approval"
            if inflight_list:
                elapsed_s = max(x["elapsed_s"] for x in inflight_list)
            elif model_started > 0:
                elapsed_s = max(0.0, now - model_started)
        elif live and isinstance(last_alert, dict) and last_alert.get("kind") == "stall":
            st_name = "stalled"
            if inflight_list:
                elapsed_s = max(x["elapsed_s"] for x in inflight_list)
            elif last_alert.get("ts"):
                elapsed_s = max(0.0, now - float(last_alert["ts"]))
        elif live and inflight_list:
            st_name = "tool"
            elapsed_s = max(x["elapsed_s"] for x in inflight_list)
        elif live and (sess.get("phase") == "model" or generating_idxs):
            st_name = "model"
            if model_started > 0:
                elapsed_s = max(0.0, now - model_started)
        elif live and (sess.get("phase") == "bg_wait" or bg_tasks):
            st_name = "bg_wait"
            if updated_at > 0:
                elapsed_s = max(0.0, now - updated_at)
        else:
            st_name = "idle"
            elapsed_s = 0.0

        cwd_val = str(sess.get("cwd") or "")
        proj_val = str(sess.get("project") or "") or (Path(cwd_val).name if cwd_val else "")
        items.append(
            {
                "cid": cid,
                "kind": kind,
                "parent_cid": str(sess.get("parent_cid") or ""),
                "role": str(sess.get("role") or ""),
                "live": live,
                "state": st_name,
                "elapsed_s": round(max(0.0, elapsed_s), 1),
                "phase": str(sess.get("phase") or "idle"),
                "agy_pid": agy_pid,
                "cwd": cwd_val,
                "project": proj_val,
                "model": str(sess.get("model") or ""),
                "turn_step_count": int(sess.get("turn_step_count") or 0),
                "total_steps": int(sess.get("total_steps") or 0),
                "turn_tool_count": int(sess.get("turn_tool_count") or 0),
                "turn_started_epoch": float(sess.get("turn_started_epoch") or 0.0),
                "prompt_preview": clean_prompt_preview(str(sess.get("last_user_input") or "")),
                "inflight": inflight_list,
                "bg_tasks": bg_tasks,
                "last_step": sess.get("last_step") if isinstance(sess.get("last_step"), dict) else None,
                "last_alert": last_alert,
                "updated_at": round(updated_at, 3),
            }
        )

    pid_to_main = {
        item["agy_pid"]: item["cid"]
        for item in items
        if item["kind"] == "main" and item["live"] and item["agy_pid"]
    }
    for item in items:
        if item["kind"] == "subagent" and not item["parent_cid"] and item["agy_pid"] in pid_to_main:
            item["parent_cid"] = pid_to_main[item["agy_pid"]]

    filtered = [
        item
        for item in items
        if (item["live"] or include_closed)
        and (
            not cid_prefix
            or item["cid"].startswith(cid_prefix)
            or item["parent_cid"].startswith(cid_prefix)
        )
    ]

    visible_cids = {item["cid"] for item in filtered}
    children_map: dict[str, list[dict[str, Any]]] = {}
    roots: list[dict[str, Any]] = []
    for item in filtered:
        pcid = item["parent_cid"]
        if pcid and pcid in visible_cids:
            children_map.setdefault(pcid, []).append(item)
        else:
            roots.append(item)

    sort_key = lambda x: (not x["live"], -float(x["updated_at"]), x["cid"])
    roots.sort(key=sort_key)
    for clist in children_map.values():
        clist.sort(key=sort_key)

    ordered: list[dict[str, Any]] = []
    visited: set[str] = set()

    def _emit_tree(node: dict[str, Any]) -> None:
        if node["cid"] in visited:
            return
        visited.add(node["cid"])
        ordered.append(node)
        for child in children_map.get(node["cid"], ()):
            _emit_tree(child)

    for root in roots:
        _emit_tree(root)
    return ordered


def _fmt_elapsed(seconds: float) -> str:
    if seconds <= 0:
        return ""
    if seconds < 10:
        return f"{seconds:.1f}s"
    if seconds < 60:
        return f"{int(round(seconds))}s"
    mins, secs = divmod(int(seconds), 60)
    return f"{mins}m{secs:02d}s"


def render_ps_human(
    snapshots: list[dict[str, Any]],
    state: dict[str, Any],
    watcher_alive: bool,
    color_mode: str = "auto",
) -> str:
    c = _make_styler(color_mode)
    live_cnt = sum(1 for s in snapshots if s["live"])
    enabled_tag = "" if state.get("enabled", True) else f" {c['red']}[DISABLED]{c['reset']}"
    watcher_s = f"{c['green']}RUNNING{c['reset']}" if watcher_alive else f"{c['dim']}idle{c['reset']}"
    lines = [f"{c['bold']}agy-watch ps{c['reset']}{enabled_tag} | {live_cnt} live | watcher: {watcher_s}"]

    if not snapshots:
        lines.append(f"  {c['dim']}(no active agy sessions — pass --all to view closed sessions){c['reset']}")
        return "\n".join(lines)

    visible_cids = {s["cid"] for s in snapshots}
    state_style = {
        "waiting_approval": ("⏸", "WAITING APPROVAL", f"{c['yellow']}{c['bold']}"),
        "stalled": ("!", "stalled", f"{c['red']}{c['bold']}"),
        "tool": ("▶", "tool", c["cyan"]),
        "model": ("◈", "model", c["blue"]),
        "bg_wait": ("⏳", "bg_wait", c["magenta"]),
        "idle": ("·", "idle", c["green"]),
    }

    for s in snapshots:
        is_child = bool(s["kind"] == "subagent" and s["parent_cid"] and s["parent_cid"] in visible_cids)
        indent = "  └─ " if is_child else ""
        sub_pad = "       " if is_child else "  "

        if not s["live"] and s["state"] == "idle":
            glyph, st_txt, st_col = "○", "closed", c["dim"]
        else:
            glyph, st_txt, st_col = state_style.get(s["state"], ("·", s["state"], ""))

        if s["kind"] == "subagent":
            role_lbl = s["role"] or "subagent"
            proj_sfx = f" ({s['project']})" if not is_child and s["project"] else ""
            label = f"[{role_lbl}]{proj_sfx}"
        else:
            label = f"[{s['project'] or 'unknown'}]"

        el_txt = _fmt_elapsed(float(s["elapsed_s"] or 0.0))
        el_part = f" {el_txt}" if el_txt else ""
        closed_tag = f" {c['dim']}closed{c['reset']}" if not s["live"] and st_txt != "closed" else ""
        turn_ts = float(s.get("turn_started_epoch") or 0.0)
        turn_el = f" turn:{_fmt_elapsed(max(0.0, time.time() - turn_ts))}" if turn_ts > 0.0 else ""
        lines.append(
            f"{indent}{st_col}{glyph}{c['reset']} {c['bold']}{s['cid'][:8]}{c['reset']} "
            f"{label}  {st_col}{st_txt}{el_part}{c['reset']}  "
            f"{c['dim']}steps:{s.get('turn_step_count', 0)}/{s.get('total_steps', 0)} "
            f"tools:{s['turn_tool_count']}{turn_el}{c['reset']}{closed_tag}"
        )

        if s["prompt_preview"] and s["kind"] == "main":
            lines.append(f"{sub_pad}{c['dim']}prompt:{c['reset']} \"{s['prompt_preview']}\"")

        for t in s["inflight"]:
            t_el = _fmt_elapsed(float(t.get("elapsed_s") or 0.0)) or "0.0s"
            tgt = f": {t['target']}" if t.get("target") else ""
            lines.append(f"{sub_pad}{c['cyan']}▶ {t.get('name', '')} ({t_el}){tgt}{c['reset']}")

        for bt in s["bg_tasks"]:
            bt_info = bt.get("log_tail") or bt.get("desc") or ""
            bt_sfx = f": {bt_info}" if bt_info else ""
            lines.append(
                f"{sub_pad}{c['magenta']}⏳ task-{bt['step_idx']} ({bt['log_bytes']}B){bt_sfx}{c['reset']}"
            )

        if s["state"] == "idle" and isinstance(s.get("last_step"), dict):
            ls = s["last_step"]
            ls_tgt = f" {ls['target']}" if ls.get("target") else ""
            lines.append(
                f"{sub_pad}{c['dim']}last: {ls.get('tool', '')}{ls_tgt} "
                f"({ls.get('duration_ms', 0)}ms, {ls.get('status', '')}){c['reset']}"
            )

        if isinstance(s.get("last_alert"), dict):
            la = s["last_alert"]
            lines.append(f"{sub_pad}{c['red']}! alert: {la.get('kind', '')}:{la.get('detail', '')}{c['reset']}")

    return "\n".join(lines)


def _ps_json_payload(include_closed: bool, cid_prefix: str) -> dict[str, Any]:
    st = load_state()
    return {
        "ts": utc_iso_now(),
        "enabled": bool(st.get("enabled", True)),
        "watcher_running": _is_watcher_alive(),
        "counters": {
            "loops_blocked": int(st.get("loops_blocked") or 0),
            "thrash_pivots": int(st.get("thrash_pivots") or 0),
            "hangs_bounced": int(st.get("hangs_bounced") or 0),
            "late_hangs_killed": int(st.get("late_hangs_killed") or 0),
        },
        "sessions": collect_session_snapshots(include_closed=include_closed, cid_prefix=cid_prefix),
    }


def cmd_ps(args: argparse.Namespace) -> int:
    include_closed = bool(args.all)
    cid_prefix = str(args.cid or "").strip()
    watch_interval = args.watch
    use_json = bool(args.json)
    color_mode = str(args.color or "auto")

    if watch_interval is None:
        if use_json:
            print(json.dumps(_ps_json_payload(include_closed, cid_prefix), indent=2, ensure_ascii=True))
        else:
            st = load_state()
            snaps = collect_session_snapshots(include_closed=include_closed, cid_prefix=cid_prefix)
            print(render_ps_human(snaps, st, _is_watcher_alive(), color_mode=color_mode))
        return 0

    sleep_s = max(0.1, float(watch_interval))
    is_tty = sys.stdout.isatty()
    while True:
        if use_json:
            print(
                json.dumps(_ps_json_payload(include_closed, cid_prefix), ensure_ascii=True, separators=(",", ":")),
                flush=True,
            )
        else:
            st = load_state()
            snaps = collect_session_snapshots(include_closed=include_closed, cid_prefix=cid_prefix)
            frame = render_ps_human(snaps, st, _is_watcher_alive(), color_mode=color_mode)
            if is_tty:
                sys.stdout.write("\033[2J\033[H" + frame + "\n")
                sys.stdout.flush()
            else:
                print(frame, flush=True)
                print("---", flush=True)
        time.sleep(sleep_s)


def _format_local_hms(iso_ts: str) -> str:
    if not iso_ts:
        return "--:--:--"
    try:
        norm = iso_ts[:-1] + "+00:00" if iso_ts.endswith("Z") else iso_ts
        parsed = dt.datetime.fromisoformat(norm)
        if parsed.tzinfo is None:
            parsed = parsed.replace(tzinfo=dt.timezone.utc)
        return parsed.astimezone().strftime("%H:%M:%S")
    except Exception:
        return iso_ts[11:19] if len(iso_ts) >= 19 else "--:--:--"


def _load_session_labels_cache(cache: dict[str, tuple[float, dict[str, str]]]) -> None:
    if not SESSIONS_DIR.is_dir():
        return
    for sp in SESSIONS_DIR.glob("*.json"):
        cid = sanitize_cid(sp.stem)
        if not cid:
            continue
        with contextlib.suppress(Exception):
            mtime = sp.stat().st_mtime
            prev = cache.get(cid)
            if prev is not None and prev[0] == mtime:
                continue
            s = load_session(cid)
            cwd_val = str(s.get("cwd") or "")
            proj = str(s.get("project") or "") or (Path(cwd_val).name if cwd_val else "")
            role = str(s.get("role") or "")
            is_sub = bool(s.get("parent_cid") or role)
            cache[cid] = (
                mtime,
                {
                    "project": proj,
                    "role": role,
                    "is_sub": "1" if is_sub else "",
                },
            )


def _resolve_event_label(ev: dict[str, Any], cache: dict[str, tuple[float, dict[str, str]]]) -> str:
    cid = str(ev.get("cid") or "")
    if cid not in cache:
        _load_session_labels_cache(cache)
    info = cache.get(cid, (0.0, {}))[1]
    proj = str(ev.get("project") or info.get("project") or "")
    role = info.get("role") or ""
    if info.get("is_sub"):
        return f"sub:{role[:12]}" if role else (f"sub:{proj[:12]}" if proj else "sub")
    return (proj or "-")[:18]


def _format_stream_event_human(
    ev: dict[str, Any],
    cache: dict[str, tuple[float, dict[str, str]]],
    c: dict[str, str],
) -> str:
    hms = _format_local_hms(str(ev.get("ts") or ""))
    cid = str(ev.get("cid") or "")
    label = _resolve_event_label(ev, cache)
    ev_name = str(ev.get("event") or "")
    status = str(ev.get("status") or "")
    tool = str(ev.get("tool") or "")
    target = str(ev.get("target") or "")
    detail = str(ev.get("detail") or "")
    dur = ev.get("duration_ms")

    glyph_map = {
        "model_start": ("◈", c["blue"]),
        "model_done": ("◇", c["dim"]),
        "tool_start": ("▶", c["cyan"]),
        "loop_blocked": ("✕", f"{c['red']}{c['bold']}"),
        "stop_bounce": ("↻", c["yellow"]),
        "turn_stop": ("■", c["dim"]),
        "session_closed": ("○", c["dim"]),
        "tool_stall_alert": ("!", f"{c['red']}{c['bold']}"),
        "model_stall_alert": ("!", f"{c['red']}{c['bold']}"),
        "late_stall_alert": ("!", f"{c['red']}{c['bold']}"),
        "late_hang_killed": ("!", f"{c['red']}{c['bold']}"),
    }
    if ev_name == "tool_done":
        glyph, col = ("✓", c["green"]) if status == "ok" else ("✗", c["red"])
    else:
        glyph, col = glyph_map.get(ev_name, ("·", ""))

    tool_part = f"  {c['bold']}{tool}{c['reset']}" if tool else ""
    body = target or detail
    body_part = f"  {body}" if body else (f"  [{status}]" if status and status != "ok" else "")
    dur_part = f" {c['dim']}({dur}ms){c['reset']}" if dur is not None and ev_name in {"model_done", "tool_done"} else ""
    return f"{c['dim']}{hms}{c['reset']}  {cid[:8]} [{label}]  {col}{glyph} {ev_name:<15}{c['reset']}{tool_part}{body_part}{dur_part}"


def _emit_stream_event(
    ev: dict[str, Any],
    cache: dict[str, tuple[float, dict[str, str]]],
    use_json: bool,
    c: dict[str, str],
) -> None:
    if use_json:
        out = {"kind": "event", **ev}
        if not out.get("project"):
            cid = str(ev.get("cid") or "")
            if cid not in cache:
                _load_session_labels_cache(cache)
            proj = cache.get(cid, (0.0, {}))[1].get("project")
            if proj:
                out["project"] = proj
        print(json.dumps(out, ensure_ascii=True, separators=(",", ":")), flush=True)
    else:
        print(_format_stream_event_human(ev, cache, c), flush=True)


def _emit_task_output_line(
    cid: str,
    project: str,
    step_idx: int,
    task_id: str,
    line_text: str,
    use_json: bool,
    c: dict[str, str],
) -> None:
    if use_json:
        rec = {
            "ts": utc_iso_now(),
            "kind": "task_output",
            "cid": cid,
            "project": project,
            "step_idx": step_idx,
            "task_id": task_id,
            "line": line_text,
        }
        print(json.dumps(rec, ensure_ascii=True, separators=(",", ":")), flush=True)
    else:
        hms = dt.datetime.now().strftime("%H:%M:%S")
        lbl = (project or "-")[:18]
        tname = f"task-{step_idx}"
        print(f"{c['dim']}{hms}{c['reset']}  {cid[:8]} [{lbl}]  {c['magenta']}⏳ {tname:<15}{c['reset']}  {line_text}", flush=True)


def _read_initial_events(n: int, cid_prefix: str) -> tuple[list[dict[str, Any]], int | None, int, str]:
    """Read tail of events.jsonl up to last complete line; return (last_n_matching, inode, offset, buf)."""
    if not EVENTS_FILE.is_file():
        return [], None, 0, ""
    try:
        with EVENTS_FILE.open("rb") as fh:
            st = os.fstat(fh.fileno())
            inode = st.st_ino
            size = st.st_size
            read_from = max(0, size - 262_144) if n > 0 else size
            if read_from > 0:
                fh.seek(read_from)
                fh.readline()
            actual_start = fh.tell()
            raw_bytes = fh.read()
        text = raw_bytes.decode("utf-8", errors="replace")
        trailing = ""
        if text and not text.endswith("\n"):
            last_nl = text.rfind("\n")
            if last_nl >= 0:
                trailing = text[last_nl + 1 :]
                text = text[: last_nl + 1]
            else:
                trailing = text
                text = ""
        offset = actual_start + len(raw_bytes)
        if n <= 0:
            return [], inode, offset, trailing
        matched: list[dict[str, Any]] = []
        for raw in text.splitlines():
            if not raw.strip():
                continue
            try:
                d = json.loads(raw)
            except Exception:
                continue
            if not isinstance(d, dict):
                continue
            if cid_prefix and not str(d.get("cid") or "").startswith(cid_prefix):
                continue
            matched.append(d)
        return matched[-n:], inode, offset, trailing
    except Exception:
        return [], None, 0, ""


def _scan_bg_task_logs(
    task_offsets: dict[tuple[str, int], int],
    task_bufs: dict[tuple[str, int], str],
    cid_prefix: str,
    emit: bool,
    use_json: bool,
    c: dict[str, str],
) -> None:
    snaps = collect_session_snapshots(include_closed=False, cid_prefix=cid_prefix)
    active_keys: set[tuple[str, int]] = set()
    for s in snaps:
        scid = s["cid"]
        proj = str(s.get("project") or "")
        for bt in s.get("bg_tasks") or []:
            s_idx = int(bt["step_idx"])
            task_id = str(bt.get("task_id") or "")
            key = (scid, s_idx)
            active_keys.add(key)
            log_path = CLI_DATA_DIR / "brain" / scid / ".system_generated" / "tasks" / f"task-{s_idx}.log"
            if not log_path.is_file():
                task_offsets.setdefault(key, 0)
                continue
            with contextlib.suppress(Exception):
                size = log_path.stat().st_size
                if not emit:
                    task_offsets[key] = size
                    task_bufs[key] = ""
                    continue
                if key not in task_offsets:
                    task_offsets[key] = 0
                off = task_offsets[key]
                if size < off:
                    off = 0
                    task_bufs[key] = ""
                if size > off:
                    with log_path.open("rb") as fh:
                        fh.seek(off)
                        chunk = fh.read()
                    task_offsets[key] = off + len(chunk)
                    buf = task_bufs.get(key, "") + chunk.decode("utf-8", errors="replace")
                    while "\n" in buf:
                        line, buf = buf.split("\n", 1)
                        clean = WS_RE.sub(" ", line.rstrip("\r")).strip()
                        if clean:
                            _emit_task_output_line(scid, proj, s_idx, task_id, _trunc_str(clean, 140), use_json, c)
                    task_bufs[key] = buf
    for stale_key in list(task_offsets.keys()):
        if stale_key not in active_keys:
            task_offsets.pop(stale_key, None)
            task_bufs.pop(stale_key, None)


def cmd_stream(args: argparse.Namespace) -> int:
    n_init = max(0, int(args.n))
    follow = not bool(args.no_follow)
    watch_tasks = not bool(args.no_tasks)
    cid_prefix = str(args.cid or "").strip()
    use_json = bool(args.json)
    interval = max(0.02, float(args.interval))
    c = _make_styler(str(args.color or "auto"))

    label_cache: dict[str, tuple[float, dict[str, str]]] = {}
    _load_session_labels_cache(label_cache)

    initial_events, ev_inode, ev_offset, ev_buf = _read_initial_events(n_init, cid_prefix)
    for ev in initial_events:
        _emit_stream_event(ev, label_cache, use_json, c)

    if not follow:
        sys.stdout.flush()
        return 0

    task_offsets: dict[tuple[str, int], int] = {}
    task_bufs: dict[tuple[str, int], str] = {}
    if watch_tasks:
        _scan_bg_task_logs(task_offsets, task_bufs, cid_prefix, emit=False, use_json=use_json, c=c)

    task_poll_every = min(1.0, max(0.15, interval * 4.0))
    last_task_scan = time.monotonic()

    while True:
        if EVENTS_FILE.is_file():
            with contextlib.suppress(Exception):
                st = EVENTS_FILE.stat()
                if ev_inode != st.st_ino or st.st_size < ev_offset:
                    ev_inode = st.st_ino
                    ev_offset = 0
                    ev_buf = ""
                if st.st_size > ev_offset:
                    with EVENTS_FILE.open("rb") as fh:
                        fh.seek(ev_offset)
                        chunk = fh.read()
                    ev_offset += len(chunk)
                    ev_buf += chunk.decode("utf-8", errors="replace")
                    while "\n" in ev_buf:
                        raw_line, ev_buf = ev_buf.split("\n", 1)
                        if not raw_line.strip():
                            continue
                        try:
                            d = json.loads(raw_line)
                        except Exception:
                            continue
                        if not isinstance(d, dict):
                            continue
                        if cid_prefix and not str(d.get("cid") or "").startswith(cid_prefix):
                            continue
                        _emit_stream_event(d, label_cache, use_json, c)

        if watch_tasks and (time.monotonic() - last_task_scan >= task_poll_every):
            last_task_scan = time.monotonic()
            _scan_bg_task_logs(task_offsets, task_bufs, cid_prefix, emit=True, use_json=use_json, c=c)

        sys.stdout.flush()
        time.sleep(interval)


def cmd_toggle(enabled: bool) -> int:
    st = update_state_field(lambda s: s.__setitem__("enabled", enabled))
    print(f"agy-watch: {'ENABLED' if st['enabled'] else 'DISABLED'}")
    return 0


def cmd_autokill(enabled: bool) -> int:
    st = update_state_field(lambda s: s.__setitem__("auto_kill_late_hangs", enabled))
    print(f"agy-watch auto_kill_late_hangs: {bool(st['auto_kill_late_hangs'])}")
    return 0


def cmd_tail_file(path: Path, n: int) -> int:
    if not path.is_file():
        print(f"(no file yet: {path})")
        return 0
    lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    for line in lines[-max(1, n) :]:
        print(line)
    return 0


def cmd_reset(_args: argparse.Namespace) -> int:
    ensure_dirs()
    with file_lock(STATE_LOCK):
        st = load_state()
        for k in ("loops_blocked", "thrash_pivots", "hangs_bounced", "late_hangs_killed"):
            st[k] = 0
        atomic_write_json(STATE_FILE, st)
    if SESSIONS_DIR.is_dir():
        for p in SESSIONS_DIR.glob("*.json"):
            with contextlib.suppress(Exception):
                p.unlink()
    print("agy-watch: counters and session state reset.")
    return 0


def cmd_doctor(_args: argparse.Namespace) -> int:
    ensure_dirs()
    st = load_state()
    alive = _is_watcher_alive()
    problems = 0

    print(f"agy-watch doctor ({utc_iso_now()}):")
    print(f"  home: {WATCHDOG_HOME} | cli_data: {CLI_DATA_DIR}")
    print(
        f"  state: enabled={st.get('enabled', True)} auto_kill={st.get('auto_kill_late_hangs', True)} "
        f"watcher={'RUNNING' if alive else 'idle (stopped)'}"
    )

    hooks_file = Path.home() / ".gemini" / "config" / "plugins" / "watchdog" / "hooks.json"
    required_events = ("PreInvocation", "PreToolUse", "PostToolUse", "Stop")
    hooks_ok = False
    missing_ev: list[str] = []
    if hooks_file.is_file():
        def _entry_has_watch_cmd(entry: Any) -> bool:
            if not isinstance(entry, dict):
                return False
            if "agy-watch" in str(entry.get("command") or ""):
                return True
            sub_hooks = entry.get("hooks")
            return isinstance(sub_hooks, list) and any(
                isinstance(h, dict) and "agy-watch" in str(h.get("command") or "") for h in sub_hooks
            )

        with contextlib.suppress(Exception):
            hj = json.loads(hooks_file.read_text(encoding="utf-8"))
            wd = hj.get("watchdog") if isinstance(hj, dict) else None
            if isinstance(wd, dict) and wd.get("enabled", True):
                for ev in required_events:
                    entries = wd.get(ev) or []
                    if not any(_entry_has_watch_cmd(e) for e in entries):
                        missing_ev.append(ev)
                hooks_ok = not missing_ev
    if hooks_ok:
        print(f"  hooks ({hooks_file}): OK ({', '.join(required_events)})")
    else:
        problems += 1
        print(f"  hooks ({hooks_file}): WARN missing={missing_ev or ['plugin/file']}")

    for label, bin_p in (
        ("agy-watch", Path(__file__).resolve()),
        (
            "agy-statusline",
            Path(
                os.environ.get("AGY_STATUSLINE_BIN")
                or shutil.which("agy-statusline")
                or str(Path.home() / ".local" / "bin" / "agy-statusline")
            ),
        ),
    ):
        ok_bin = bin_p.is_file() and os.access(bin_p, os.X_OK)
        print(f"  binary {label} ({bin_p}): {'OK' if ok_bin else 'MISSING/NOT EXECUTABLE'}")
        if not ok_bin:
            problems += 1

    sess_files = list(SESSIONS_DIR.glob("*.json")) if SESSIONS_DIR.is_dir() else []
    with_steps = 0
    with_timer = 0
    for sp in sess_files:
        s = load_session(sp.stem)
        if int(s.get("turn_step_count") or 0) > 0:
            with_steps += 1
        if float(s.get("turn_started_epoch") or 0.0) > 0.0:
            with_timer += 1
    print(f"  sessions: {len(sess_files)} stored (turn_step_count={with_steps}, turn_started_epoch={with_timer})")

    ev_lines = EVENTS_FILE.read_text(encoding="utf-8", errors="replace").splitlines() if EVENTS_FILE.is_file() else []
    last_ev_ts = ""
    if ev_lines:
        with contextlib.suppress(Exception):
            last_ev_ts = str(json.loads(ev_lines[-1]).get("ts") or "")
    print(f"  events ({EVENTS_FILE}): {len(ev_lines)} lines | latest={last_ev_ts or 'none'}")

    log_lines = LOG_FILE.read_text(encoding="utf-8", errors="replace").splitlines() if LOG_FILE.is_file() else []
    print(f"  log ({LOG_FILE}): {len(log_lines)} lines")
    return 0 if problems == 0 else 1


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="agy-watch", description="Zero-token execution watchdog for Antigravity CLI.")
    sub = p.add_subparsers(dest="cmd")

    sub.add_parser("pre-invocation-hook")
    sub.add_parser("pre-tool-hook")
    sub.add_parser("post-tool-hook")
    sub.add_parser("stop-hook")
    sub.add_parser("daemon-loop")

    sub.add_parser("status")
    sub.add_parser("doctor")

    ps = sub.add_parser("ps", aliases=["sessions"])
    ps.add_argument("-a", "--all", action="store_true", help="Include closed/recent sessions")
    ps.add_argument("--json", action="store_true", help="Output structured JSON snapshot (or NDJSON with --watch)")
    ps.add_argument("-w", "--watch", nargs="?", const=1.0, type=float, default=None, help="Refresh interval in seconds")
    ps.add_argument("--cid", default="", help="Filter by conversation ID prefix")
    ps.add_argument("--color", choices=["auto", "always", "never"], default="auto")

    strm = sub.add_parser("stream", aliases=["tail"])
    strm.add_argument("-n", type=int, default=20, help="Number of recent events to print initially")
    strm.add_argument("--no-follow", action="store_true", help="Print recent events and exit without tailing")
    strm.add_argument("--no-tasks", action="store_true", help="Disable live background task log tailing")
    strm.add_argument("--cid", default="", help="Filter by conversation ID prefix")
    strm.add_argument("--json", action="store_true", help="Output line-buffered NDJSON events")
    strm.add_argument("--interval", type=float, default=0.25, help="Poll interval in seconds")
    strm.add_argument("--color", choices=["auto", "always", "never"], default="auto")

    sub.add_parser("on")
    sub.add_parser("off")
    ak = sub.add_parser("autokill")
    ak.add_argument("mode", choices=["on", "off"])

    lg = sub.add_parser("logs")
    lg.add_argument("-n", type=int, default=30)

    ev = sub.add_parser("events")
    ev.add_argument("-n", type=int, default=30)

    sub.add_parser("reset")
    return p


def _silence_broken_pipe() -> None:
    with contextlib.suppress(Exception):
        devnull = os.open(os.devnull, os.O_WRONLY)
        os.dup2(devnull, sys.stdout.fileno())
        os.close(devnull)


def main() -> int:
    args = build_parser().parse_args()
    cmd = args.cmd or "status"
    try:
        if cmd == "pre-invocation-hook":
            return cmd_pre_invocation_hook(args)
        if cmd == "pre-tool-hook":
            return cmd_pre_tool_hook(args)
        if cmd == "post-tool-hook":
            return cmd_post_tool_hook(args)
        if cmd == "stop-hook":
            return cmd_stop_hook(args)
        if cmd == "daemon-loop":
            return cmd_daemon_loop(args)
        if cmd == "status":
            return cmd_status(args)
        if cmd == "doctor":
            return cmd_doctor(args)
        if cmd in {"ps", "sessions"}:
            return cmd_ps(args)
        if cmd in {"stream", "tail"}:
            return cmd_stream(args)
        if cmd == "on":
            return cmd_toggle(True)
        if cmd == "off":
            return cmd_toggle(False)
        if cmd == "autokill":
            return cmd_autokill(args.mode == "on")
        if cmd == "logs":
            return cmd_tail_file(LOG_FILE, args.n)
        if cmd == "events":
            return cmd_tail_file(EVENTS_FILE, args.n)
        if cmd == "reset":
            return cmd_reset(args)
    except KeyboardInterrupt:
        return 0
    except BrokenPipeError:
        _silence_broken_pipe()
        return 0
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
