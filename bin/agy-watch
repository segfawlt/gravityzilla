#!/usr/bin/env python3
"""
agy-watch: Zero-token execution tracking, loop circuit-breaker, and hung-task
recovery for Google Antigravity CLI (`agy`).

Hook Architecture (`~/.gemini/config/plugins/watchdog/hooks.json`):
  1. `PreInvocation`: Records model turn boundaries (`model_start`), syncs user
     turn state, pops queued guidance (`ABAB_HASH_FLIP`, late-hang kill notes,
     3x error thrash breaker, 45-step soft check), and wakes `daemon-loop`.
  2. `PreToolUse` (`*`): Closes active model span (`model_done`), blocks >=3
     identical `(tool, canonical_args, ws_sig)` calls with unchanged workspace
     state via `{"decision": "deny"}`, and starts monotonic tool timer.
  3. `PostToolUse` (`*`): Records exact `duration_ms` matched by `toolCall.id`,
     updates error streaks, detects `ABAB_HASH_FLIP` edit oscillation, and bumps
     workspace `mutation_seq`.
  4. `Stop`: When `NO_TOOL_CALL` pauses with `fullyIdle: false` (backgrounded
     `run_command` task), checks `task-<idx>.log` bytes + `/proc/<pid>/stat` CPU
     ticks for up to `stop_idle_bounce_s` (4s on stdin prompt, 12s on 0-CPU/0-IO)
     and returns `{"decision": "continue", "reason": ...}` so the agent wakes
     and inspects `manage_task` automatically.
  5. `daemon-loop`: Self-exiting detached monitor (singleton `watcher.lock`)
     polling every 3s while sessions are active. Reads ONLY `/proc/<pid>/stat`
     and `/proc/<pid>/comm`, honors `presence/<cid>.lock` and SQLite
     `CORTEX_STEP_STATUS_WAITING` (`9`), notifies on sync/model stalls, and
     surgically terminates single unambiguous hung child `run_command` shells.
"""

from __future__ import annotations

import argparse
import contextlib
import datetime as dt
import fcntl
import hashlib
import json
import os
import re
import shlex
import shutil
import signal
import sqlite3
import subprocess
import sys
import time
from pathlib import Path
from typing import Any, Iterator

WATCHDOG_HOME = Path(
    os.environ.get("AGY_WATCHDOG_HOME") or (Path.home() / ".agents" / "watchdog")
).expanduser()
CLI_DATA_DIR = Path(
    os.environ.get("AGY_CLI_DATA_DIR") or (Path.home() / ".gemini" / "antigravity-cli")
).expanduser()

STATE_FILE = WATCHDOG_HOME / "state.json"
STATE_LOCK = WATCHDOG_HOME / ".state.lock"
SESSIONS_DIR = WATCHDOG_HOME / "sessions"
EVENTS_FILE = WATCHDOG_HOME / "events.jsonl"
EVENTS_LOCK = WATCHDOG_HOME / ".events.lock"
LOG_FILE = WATCHDOG_HOME / "watchdog.log"
WATCHER_LOCK = WATCHDOG_HOME / "watcher.lock"

MAX_EVENTS_BYTES = 1_048_576
MAX_LOG_BYTES = 524_288
MAX_HASH_FILE_BYTES = 2_097_152
TRANSCRIPT_TAIL_BYTES = 65_536

# Protobuf CortexStepStatus integer values verified in agy 1.5.9
STEP_STATUS_PENDING = 1
STEP_STATUS_RUNNING = 2
STEP_STATUS_DONE = 3
STEP_STATUS_GENERATING = 8
STEP_STATUS_WAITING = 9

SHELL_COMMS = frozenset({"bash", "sh", "zsh", "dash", "fish", "rtk"})
EXEMPT_LOOP_TOOLS = frozenset({"ask_question", "exit_plan_mode", "send_message", "schedule"})
MUTATING_FILE_TOOLS = frozenset(
    {
        "edit_file",
        "write_file",
        "replace_file_content",
        "multi_replace_file_content",
        "write_to_file",
        "create_file",
        "delete_file",
    }
)
