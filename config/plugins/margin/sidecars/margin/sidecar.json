{
  "command": "node",
  "args": ["--watch", "main.mjs"],
  "restart_policy": "always",
  "display_name": "Overview",
  "description": "Right-side Overview pane for the current conversation: live status, the ask, the agent's take, plan progress, verdict, and what it used.",
  "has_web_ui": true,
  "agent_permissions": {
    "allows_user_interactions": false
  },
  "ui_config": {
    "display_name": "Overview",
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "Overview"
      }
    ]
  }
}
