{
  "watchdog": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "~/.local/bin/agy-watch pre-invocation-hook",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/agy-watch pre-tool-hook",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/agy-watch post-tool-hook",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "~/.local/bin/agy-watch stop-hook",
        "timeout": 20
      }
    ]
  }
}
