{
  "agentMode": "auto",
  "model": "Gemini 3.8 Flash (Medium)",
  "notifications": true,
  "permissions": {
    "allow": [
      "command(ls)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "{{HOME}}/.local/bin/agy-statusline",
    "enabled": true,
    "stack_with_default": true
  },
  "toolPermission": "always-proceed",
  "trustedWorkspaces": [
    "{{HOME}}"
  ],
  "verbosity": "high"
}
